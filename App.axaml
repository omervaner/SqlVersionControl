<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SqlVersionControl.Converters"
             x:Class="SqlVersionControl.App"
             xmlns:local="using:SqlVersionControl"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/AppTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToConnectTextConverter x:Key="BoolToConnectText"/>
            <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <conv:NullDisplayConverter x:Key="NullDisplay"/>
            <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
            <conv:ColumnStatusToColorConverter x:Key="ColumnStatusToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <!-- Global DataGrid theme — applies to ALL DataGrids in the app -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
            <Setter Property="RowBackground" Value="{DynamicResource EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridVerticalLine}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="{DynamicResource GridRowHeight}"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="DataGridRowHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="4,0,8,0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <!-- Global 2px corner radius on ALL buttons -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- Global tooltip delay: 600ms -->
        <Style Selector="ToolTip">
            <Setter Property="ShowDelay" Value="600"/>
        </Style>

        <!-- Overlay auto-hide scrollbars: thin, semi-transparent, fade in/out -->
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
        </Style>
        <Style Selector="ScrollViewer:pointerover ScrollBar">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="ScrollViewer:pointerover ScrollBar:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
        </Style>
        <Style Selector="ScrollBar:horizontal:pointerover">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
        </Style>
        <!-- Hide scrollbar arrow/repeat buttons -->
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Global button style classes -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource ButtonDanger}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.btn-toggle">
            <Setter Property="Background" Value="{DynamicResource ButtonToggleActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Application.Styles>
</Application>
