<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SqlVersionControl.Converters"
             x:Class="SqlVersionControl.App"
             xmlns:local="using:SqlVersionControl"
             Name="Lookout"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/AppTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToConnectTextConverter x:Key="BoolToConnectText"/>
            <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <conv:NullDisplayConverter x:Key="NullDisplay"/>
            <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight"/>
            <conv:ColumnStatusToColorConverter x:Key="ColumnStatusToColorConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:BadgeBackgroundConverter x:Key="BadgeBackground"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <!-- Global DataGrid theme — applies to ALL DataGrids in the app -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
            <Setter Property="RowBackground" Value="{DynamicResource EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridVerticalLine}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowHeight" Value="{DynamicResource GridRowHeight}"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="DataGridRowHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="4,0,8,0"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
        <!-- Global 2px corner radius on ALL buttons -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <!-- Global tooltip delay: 600ms -->
        <Style Selector="ToolTip">
            <Setter Property="ShowDelay" Value="600"/>
        </Style>

        <!-- Global context menu styling — matches app theme -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ToolbarBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ContextMenu MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="ContextMenu MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="ContextMenu Separator">
            <Setter Property="Background" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Overlay auto-hide scrollbars: thin, semi-transparent, fade in/out -->
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Width" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
        </Style>
        <Style Selector="ScrollViewer:pointerover ScrollBar">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="ScrollViewer:pointerover ScrollBar:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
        </Style>
        <Style Selector="ScrollBar:horizontal:pointerover">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
        </Style>
        <!-- Hide scrollbar arrow/repeat buttons -->
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Global button style classes -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimary}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="{DynamicResource ButtonDanger}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBright}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="Button.btn-toggle">
            <Setter Property="Background" Value="{DynamicResource ButtonToggleActive}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <!-- Context menu (MenuFlyout) styling — match app design system -->
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ToolbarBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>
        <Style Selector="MenuFlyoutPresenter Separator">
            <Setter Property="Background" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- ══ Dialog Base Styling ══════════════════════════════════════ -->
        <!-- All dialogs get consistent chrome, background, and font size -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Dialog input fields -->
        <Style Selector="Window TextBox">
            <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Dialog combo boxes -->
        <Style Selector="Window ComboBox">
            <Setter Property="Background" Value="{DynamicResource EditorBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Dialog check boxes -->
        <Style Selector="Window CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Dialog radio buttons -->
        <Style Selector="Window RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Dialog labels -->
        <Style Selector="Window TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- Dialog section headers (blue accent, semibold) -->
        <Style Selector="Window TextBlock.section-header">
            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Application.Styles>
</Application>
