<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.AlterSequenceDialog"
        Title="Alter Sequence"
        Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="20">
        <TextBlock x:Name="SequenceLabel" Grid.Row="0" FontWeight="SemiBold" FontSize="14"/>

        <StackPanel Grid.Row="1" Spacing="3" Margin="0,12,0,0">
            <TextBlock Text="Current Value:" Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
            <TextBlock x:Name="CurrentValueLabel" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5" Margin="0,12,0,0">
            <TextBlock Text="New Value:" FontWeight="SemiBold"/>
            <TextBox x:Name="ValueBox" Watermark="Enter new value..."/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Classes="btn-secondary" Padding="15,8"/>
            <Button x:Name="OkButton" Content="OK" Classes="btn-primary" Padding="15,8"/>
        </StackPanel>
    </Grid>
</Window>
