<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             xmlns:models="using:SqlVersionControl.Models"
             xmlns:views="using:SqlVersionControl.Views"
             x:Class="SqlVersionControl.Views.QueryEditorHost"
             x:DataType="vm:QueryEditorHostViewModel">

    <Grid x:Name="MainGrid" ColumnDefinitions="280,Auto,*">

        <!-- Object Explorer Panel (shared across all tabs) -->
        <Border Grid.Column="0" x:Name="ObjectExplorerPanel" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBackground}" Padding="10,0" Height="28">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="Object Explorer" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="OeRefreshButton"
                                Grid.Column="1"
                                Content="&#x21BB;" FontSize="12"
                                Width="20" Height="20"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Refresh Object Explorer"/>
                        <Button x:Name="OeCollapseButton"
                                Grid.Column="2"
                                Content="&#x25C0;" FontSize="9"
                                Width="20" Height="20"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Collapse Object Explorer (Ctrl+B)"/>
                    </Grid>
                </Border>

                <!-- Search/Filter Bar -->
                <Border Grid.Row="1" Padding="4,2">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 x:Name="FilterBox"
                                 Watermark="Filter..."
                                 Text="{Binding ObjectExplorer.FilterText}"
                                 FontSize="11"
                                 Height="24"
                                 Padding="6,2"/>
                        <Button Grid.Column="1"
                                Content="&#xd7;"
                                Command="{Binding ObjectExplorer.ClearFilterCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                FontSize="12"
                                Padding="4,2"
                                MinWidth="0" MinHeight="0"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Clear filter"/>
                    </Grid>
                </Border>

                <TreeView Grid.Row="2" x:Name="ObjectExplorerTree"
                          Padding="0,4,4,4" Margin="-8,0,0,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding ObjectExplorer.RootNodes}">
                    <TreeView.Styles>
                        <!-- Compact spacing + two-way expand binding + filter visibility -->
                        <Style Selector="TreeViewItem" x:DataType="models:ObjectExplorerNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsVisible" Value="{Binding IsVisibleInFilter}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>

                        <!-- 2px left border on all items (transparent) to prevent layout shift on selection -->
                        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                        </Style>

                        <!-- Hover highlight -->
                        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="{DynamicResource TreeHover}"/>
                        </Style>

                        <!-- Selection highlight with 2px left accent (thickness already set above) -->
                        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="{DynamicResource TreeSelected}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TreeSelectedAccent}"/>
                        </Style>

                        <!-- Brighter expand/collapse arrow -->
                        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                            <Setter Property="Foreground" Value="{DynamicResource ExpandArrowForeground}"/>
                        </Style>

                        <!-- Indent guides: faint left border on nested items -->
                        <Style Selector="TreeViewItem TreeViewItem">
                            <Setter Property="BorderBrush" Value="{DynamicResource IndentGuide}"/>
                            <Setter Property="BorderThickness" Value="1,0,0,0"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:ObjectExplorerNode">
                            <StackPanel>
                                <!-- Separator line above category folder headers -->
                                <Border Height="1" Background="{DynamicResource TreeItemSeparator}"
                                        Opacity="0.4" Margin="0,3,0,1"
                                        IsVisible="{Binding IsCategoryFolder}"/>

                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                                <!-- Col 0: Badge (rounded rect with letter) for main nodes -->
                                <!-- Letter badge (non-database nodes) -->
                                <Border Grid.Column="0" Width="{Binding BadgeWidth}" Height="18" CornerRadius="4"
                                        IsVisible="{Binding HasBadge}"
                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource BadgeBackground}">
                                            <Binding Path="IconColor"/>
                                            <Binding Path="BadgeOpacity"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <Panel>
                                        <TextBlock Text="{Binding BadgeLetter}"
                                                   Foreground="{Binding BadgeLetterColor, Converter={StaticResource HexToBrush}}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   IsVisible="{Binding !IsDatabaseNode}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Database cylinder icon -->
                                        <Path IsVisible="{Binding IsDatabaseNode}"
                                              Stroke="{Binding IconColor, Converter={StaticResource HexToBrush}}"
                                              StrokeThickness="1.3" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Data="M1,3 C1,1 11,1 11,3 C11,5 1,5 1,3 M1,3 V9 C1,11 11,11 11,9 V3 M1,6 C1,8 11,8 11,6"/>
                                    </Panel>
                                </Border>
                                <!-- Dot icon for columns/parameters (no badge bg) -->
                                <TextBlock Grid.Column="0" Text="{Binding BadgeLetter}" FontSize="10"
                                           Foreground="{Binding IconColor, Converter={StaticResource HexToBrush}}"
                                           IsVisible="{Binding !HasBadge}"
                                           VerticalAlignment="Center" Margin="4,0,6,0"/>

                                <!-- Col 1: Name + metadata -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center" ClipToBounds="True">
                                    <!-- Connection: name + dimmed server hint -->
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="{Binding DisplayFontSize}"
                                               FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}"
                                               IsVisible="{Binding !IsColumn}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ConnectionServerHint}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding IsConnectionNode}"
                                               VerticalAlignment="Center"/>

                                    <!-- Column: name -->
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               IsVisible="{Binding IsColumn}"
                                               VerticalAlignment="Center"/>
                                    <!-- Column/Sequence: type info -->
                                    <TextBlock Text="{Binding TypeInfo}" FontSize="11"
                                               Foreground="{DynamicResource ColumnTypeForeground}"
                                               IsVisible="{Binding HasTypeInfo}"
                                               VerticalAlignment="Center"/>
                                    <!-- Column: PK badge -->
                                    <TextBlock Text="PK" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource ColumnPKForeground}"
                                               IsVisible="{Binding ShowPK}"
                                               VerticalAlignment="Center"/>
                                    <!-- Column: nullable -->
                                    <TextBlock Text="{Binding NullabilityText}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding ShowNullability}"
                                               VerticalAlignment="Center"/>
                                    <!-- Loading indicator -->
                                    <TextBlock Text="Loading..." FontSize="11" FontStyle="Italic"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding IsLoading}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Col 2: Row count (right-aligned, tables only) -->
                                <TextBlock Grid.Column="2" Text="{Binding FormattedRowCount}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding ShowRowCount}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,6,0"/>
                            </Grid>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- No matches placeholder -->
                <TextBlock Grid.Row="2" Text="Searching..."
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           FontStyle="Italic" Margin="14,8"
                           IsVisible="{Binding ObjectExplorer.IsSearching}"/>
                <TextBlock Grid.Row="2" Text="No objects matching filter"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           FontStyle="Italic" Margin="14,8"
                           IsVisible="{Binding ObjectExplorer.ShowFilterEmptyState}"/>
                <TextBlock Grid.Row="2" Text="No active connections"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           FontStyle="Italic" Margin="14,20"
                           IsVisible="{Binding ObjectExplorer.ShowEmptyState}"/>
            </Grid>
        </Border>

        <!-- Splitter (pure drag handle, no button) -->
        <GridSplitter x:Name="OeSplitter" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderDefault}"
                      ResizeDirection="Columns"/>

        <!-- Expand button (visible only when OE is collapsed) -->
        <Button x:Name="OeExpandButton" Grid.Column="0"
                Content="&#x25B6;" FontSize="9"
                Width="14" Height="24"
                Padding="0" MinWidth="0" MinHeight="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource TextSecondary}"
                BorderThickness="0"
                Cursor="Hand"
                IsVisible="False"
                ToolTip.Tip="Expand Object Explorer (Ctrl+B)"
                ZIndex="1"/>

        <!-- Right side: Query Tab Strip (merged with toolbar) + Tab Content -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <!-- Tab Strip + Toolbar (merged into one 28px row) -->
            <Border Grid.Row="0" Background="{DynamicResource TabStripBackground}" Padding="4,0" Height="28">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                    <!-- Left overflow arrow -->
                    <Button x:Name="TabScrollLeftButton" Grid.Column="0"
                            Content="&#x25C0;" FontSize="9"
                            Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                            Padding="4,0" MinWidth="0" MinHeight="0" BorderThickness="0"
                            VerticalAlignment="Center" Cursor="Hand"
                            IsVisible="False"
                            ToolTip.Tip="Scroll tabs left"/>

                    <!-- Query tabs (scrollable — takes remaining space so toolbar stays pinned right) -->
                    <ScrollViewer x:Name="TabScrollViewer" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>

                    <!-- Right overflow arrow -->
                    <Button x:Name="TabScrollRightButton" Grid.Column="2"
                            Content="&#x25B6;" FontSize="9"
                            Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                            Padding="4,0" MinWidth="0" MinHeight="0" BorderThickness="0"
                            VerticalAlignment="Center" Cursor="Hand"
                            IsVisible="False"
                            ToolTip.Tip="Scroll tabs right"/>

                    <!-- Toolbar controls (right-aligned) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Database:" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="ToolbarDatabaseCombo"
                                  MinWidth="100" Height="22" MinHeight="0" FontSize="11"
                                  Margin="0,0" Padding="4,0"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderDefault}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Button x:Name="ToolbarRunButton" Content="Run"
                                Classes="btn-primary"
                                Padding="10,0" FontSize="11" Height="22" MinHeight="0" MinWidth="50"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Execute query (F5)"/>
                        <Button x:Name="ToolbarStopButton" Content="Stop"
                                Classes="btn-danger"
                                Padding="10,0" FontSize="11" Height="22" MinHeight="0" MinWidth="50"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Cancel execution"/>
                        <Button x:Name="ToolbarTraceButton" Content="Trace"
                                Classes="btn-secondary"
                                Padding="10,0" FontSize="11" Height="22" MinHeight="0" MinWidth="50"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="Run with trace (Ctrl+Shift+F5)"/>
                    </StackPanel>

                    <!-- Separator between Run/Stop and utility buttons -->
                    <Border Grid.Column="5" Width="1" Height="16" Background="{DynamicResource BorderDefault}"
                            Margin="8,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="AutocompleteToggleButton"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                Padding="4,2" BorderThickness="0"
                                Cursor="Hand" MinWidth="0" MinHeight="0"
                                ToolTip.Tip="Toggle autocomplete">
                            <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextSecondary}"
                                      Data="M11 0L4 8h4l-1 6 7-8h-4z"/>
                        </Button>
                        <Button x:Name="QueryHistoryButton"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                Padding="4,2" BorderThickness="0"
                                Cursor="Hand" MinWidth="0" MinHeight="0"
                                ToolTip.Tip="Query history">
                            <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextSecondary}"
                                      Data="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 2a6 6 0 1 1 0 12A6 6 0 0 1 8 2zm-.5 2v4.5l3.5 2 .5-.87-3-1.76V4z"/>
                        </Button>
                        <Button x:Name="QuickQuoteButton"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                Padding="4,2" BorderThickness="0"
                                Cursor="Hand" MinWidth="0" MinHeight="0"
                                FontFamily="Consolas, Menlo, monospace"
                                FontSize="14" FontWeight="Bold"
                                Content="&#x201C;"
                                ToolTip.Tip="Quote selection (Ctrl+Shift+Q)"/>
                        <Button x:Name="FormatButton"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                Padding="4,2" BorderThickness="0"
                                Cursor="Hand" MinWidth="0" MinHeight="0"
                                FontFamily="Consolas, Menlo, monospace"
                                FontSize="13" FontWeight="Bold"
                                Content="F"
                                ToolTip.Tip="Format SQL (Ctrl+Shift+F)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tab Content + History Panel -->
            <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
                <Panel Grid.Row="0" x:Name="TabContentPanel"/>

                <!-- History Panel (hidden by default) -->
                <GridSplitter Grid.Row="1" x:Name="HistorySplitter" Height="4"
                              Background="{DynamicResource BorderDefault}"
                              IsVisible="False"/>
                <Border Grid.Row="2" x:Name="HistoryPanel" IsVisible="False"
                        Height="200" Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Header -->
                        <Border Grid.Row="0" Padding="8,4" Background="{DynamicResource PanelHeaderBackground}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="Query History" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="HistorySearchBox" Grid.Column="1"
                                         Watermark="Search history..." FontSize="11"
                                         Margin="12,0" Height="24" Padding="6,0"
                                         BorderThickness="1" BorderBrush="{DynamicResource BorderDefault}"/>
                                <Button x:Name="HistoryCloseButton" Grid.Column="2"
                                        Content="×" Background="Transparent"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Padding="6,0" BorderThickness="0" Cursor="Hand"
                                        FontSize="14" MinWidth="0" MinHeight="0"
                                        ToolTip.Tip="Close history panel"/>
                            </Grid>
                        </Border>
                        <!-- History List -->
                        <DataGrid x:Name="HistoryGrid" Grid.Row="1"
                                  x:DataType="models:HistoryDisplayItem"
                                  IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" CanUserResizeColumns="True"
                                  CanUserSortColumns="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SQL" Width="*"
                                                    Binding="{Binding TruncatedSql}"/>
                                <DataGridTextColumn Header="Database" Width="120"
                                                    Binding="{Binding Database}"/>
                                <DataGridTextColumn Header="Rows" Width="60"
                                                    Binding="{Binding RowCount}"/>
                                <DataGridTextColumn Header="When" Width="100"
                                                    Binding="{Binding TimeAgo}"/>
                            </DataGrid.Columns>
                            <DataGrid.Styles>
                                <Style Selector="DataGridCell TextBlock">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                </Style>
                                <Style Selector="DataGridRow">
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </DataGrid.Styles>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
