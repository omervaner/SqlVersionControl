<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             xmlns:models="using:SqlVersionControl.Models"
             x:Class="SqlVersionControl.Views.QueryEditorHost"
             x:DataType="vm:QueryEditorHostViewModel">

    <Grid x:Name="MainGrid" ColumnDefinitions="220,Auto,*">

        <!-- Object Explorer Panel (shared across all tabs) -->
        <Border Grid.Column="0" x:Name="ObjectExplorerPanel" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBackground}" Padding="10,0" Height="28">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Object Explorer" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="OeCollapseButton"
                                Grid.Column="1"
                                Content="&#x25C0;" FontSize="9"
                                Width="20" Height="20"
                                Padding="0" MinWidth="0" MinHeight="0"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Collapse Object Explorer (Ctrl+B)"/>
                    </Grid>
                </Border>

                <!-- Search/Filter Bar -->
                <Border Grid.Row="1" Padding="6,2">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 x:Name="FilterBox"
                                 Watermark="Filter..."
                                 Text="{Binding ObjectExplorer.FilterText}"
                                 FontSize="11"
                                 Height="24"
                                 Padding="6,2"/>
                        <Button Grid.Column="1"
                                Content="&#xd7;"
                                Command="{Binding ObjectExplorer.ClearFilterCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextSecondary}"
                                FontSize="12"
                                Padding="4,2"
                                MinWidth="0" MinHeight="0"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Clear filter"/>
                    </Grid>
                </Border>

                <TreeView Grid.Row="2" x:Name="ObjectExplorerTree"
                          Padding="20,4,4,4"
                          ItemsSource="{Binding ObjectExplorer.RootNodes}">
                    <TreeView.Styles>
                        <!-- Compact spacing + two-way expand binding + filter visibility -->
                        <Style Selector="TreeViewItem" x:DataType="models:ObjectExplorerNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsVisible" Value="{Binding IsVisibleInFilter}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>

                        <!-- No separator on every item by default -->
                        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>

                        <!-- Hover highlight -->
                        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="{DynamicResource TreeHover}"/>
                        </Style>

                        <!-- Selection highlight with 2px left accent -->
                        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                            <Setter Property="Background" Value="{DynamicResource TreeSelected}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource TreeSelectedAccent}"/>
                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                        </Style>

                        <!-- Brighter expand/collapse arrow -->
                        <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                            <Setter Property="Foreground" Value="{DynamicResource ExpandArrowForeground}"/>
                        </Style>

                        <!-- Indent guides: faint left border on nested items -->
                        <Style Selector="TreeViewItem TreeViewItem">
                            <Setter Property="BorderBrush" Value="{DynamicResource IndentGuide}"/>
                            <Setter Property="BorderThickness" Value="1,0,0,0"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:ObjectExplorerNode">
                            <StackPanel>
                                <!-- Separator line above category folder headers -->
                                <Border Height="1" Background="{DynamicResource TreeItemSeparator}"
                                        Opacity="0.2" Margin="0,1,0,0"
                                        IsVisible="{Binding IsCategoryFolder}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                <!-- Icon dot (all nodes) -->
                                <TextBlock Text="{Binding Icon}" FontSize="10"
                                           Foreground="{Binding IconColor}"
                                           VerticalAlignment="Center"/>

                                <!-- Display name (non-column nodes) -->
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="{Binding DisplayFontSize}"
                                           FontWeight="{Binding IsBold, Converter={StaticResource BoolToFontWeight}}"
                                           IsVisible="{Binding !IsColumn}"
                                           VerticalAlignment="Center"/>

                                <!-- Column: name -->
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           IsVisible="{Binding IsColumn}"
                                           VerticalAlignment="Center"/>
                                <!-- Column/Sequence: type info -->
                                <TextBlock Text="{Binding TypeInfo}" FontSize="11"
                                           Foreground="{DynamicResource ColumnTypeForeground}"
                                           IsVisible="{Binding HasTypeInfo}"
                                           VerticalAlignment="Center"/>
                                <!-- Column: PK badge -->
                                <TextBlock Text="PK" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource ColumnPKForeground}"
                                           IsVisible="{Binding ShowPK}"
                                           VerticalAlignment="Center"/>
                                <!-- Column: nullable -->
                                <TextBlock Text="{Binding NullabilityText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding IsColumn}"
                                           VerticalAlignment="Center"/>
                                <!-- Loading indicator -->
                                <TextBlock Text="Loading..." FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding IsLoading}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- Splitter (pure drag handle, no button) -->
        <GridSplitter x:Name="OeSplitter" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderDefault}"
                      ResizeDirection="Columns"/>

        <!-- Expand button (visible only when OE is collapsed) -->
        <Button x:Name="OeExpandButton" Grid.Column="0"
                Content="&#x25B6;" FontSize="9"
                Width="14" Height="24"
                Padding="0" MinWidth="0" MinHeight="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                Foreground="{DynamicResource TextSecondary}"
                BorderThickness="0"
                Cursor="Hand"
                IsVisible="False"
                ToolTip.Tip="Expand Object Explorer (Ctrl+B)"
                ZIndex="1"/>

        <!-- Right side: Query Tab Strip (merged with toolbar) + Tab Content -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <!-- Tab Strip + Toolbar (merged into one 28px row) -->
            <Border Grid.Row="0" Background="{DynamicResource TabStripBackground}" Padding="4,0" Height="28">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">
                    <!-- Query tabs (left) -->
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>

                    <!-- Toolbar controls (right-aligned) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Database:" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="ToolbarDatabaseCombo"
                                  MinWidth="120" Height="24" FontSize="11"
                                  Margin="0,2" Padding="6,0"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderDefault}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="ToolbarRunButton" Content="Run"
                            Classes="btn-primary"
                            Padding="12,0" FontSize="11" Height="24" MinHeight="0" MinWidth="60"
                            Margin="4,2,0,2"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Execute query (F5)"/>
                    <Button Grid.Column="4" x:Name="ToolbarStopButton" Content="Stop"
                            Classes="btn-danger"
                            Padding="12,0" FontSize="11" Height="24" MinHeight="0" MinWidth="60"
                            Margin="2,2,0,2"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Cancel execution"/>

                    <!-- Separator -->
                    <Border Grid.Column="5" Width="1" Height="16" Background="{DynamicResource BorderDefault}"
                            Margin="6,0" VerticalAlignment="Center"/>

                    <Button Grid.Column="6" x:Name="AutocompleteToggleButton"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            Padding="4,2" BorderThickness="0"
                            Cursor="Hand" MinWidth="0" MinHeight="0"
                            ToolTip.Tip="Toggle autocomplete">
                        <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextSecondary}"
                                  Data="M11 0L4 8h4l-1 6 7-8h-4z"/>
                    </Button>
                    <Button Grid.Column="7" x:Name="QueryHistoryButton"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            Padding="4,2" BorderThickness="0"
                            Cursor="Hand" MinWidth="0" MinHeight="0"
                            ToolTip.Tip="Query history">
                        <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextSecondary}"
                                  Data="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 2a6 6 0 1 1 0 12A6 6 0 0 1 8 2zm-.5 2v4.5l3.5 2 .5-.87-3-1.76V4z"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Tab Content -->
            <Panel Grid.Row="1" x:Name="TabContentPanel"/>
        </Grid>
    </Grid>
</UserControl>
