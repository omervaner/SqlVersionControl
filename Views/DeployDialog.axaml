<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.DeployDialog"
        Title="Confirm Deployment"
        Width="500" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Name="TitleText" Text="Deploy Confirmation" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"/>
            <TextBlock Name="WarningText" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Details -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Name="ObjectText" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Name="TargetText" Margin="0,8,0,0"/>
            <TextBlock Name="ProdWarning" Foreground="{DynamicResource WarningSeverityCritical}" FontWeight="Bold"
                       Margin="0,12,0,0" TextWrapping="Wrap" IsVisible="False"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
            <Button Name="CancelButton" Content="Cancel" Classes="btn-secondary" Padding="16,8"/>
            <Button Name="ConfirmButton" Content="Deploy"
                    Classes="btn-primary" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
