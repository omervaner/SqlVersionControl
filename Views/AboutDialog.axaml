<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.AboutDialog"
        Title="About"
        Width="380" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="30" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="SQL Version Control" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionLabel" FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
        <TextBlock Text="Track and manage SQL Server changes"
                   FontSize="12" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
            <Button x:Name="GitHubButton" Content="GitHub Releases"
                    Background="#4a4a6e" Foreground="White" Padding="15,8"
                    Cursor="Hand"/>
            <Button x:Name="CloseButton" Content="Close"
                    Padding="15,8" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
