<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.AboutDialog"
        Title="About"
        Width="380" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="24" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Lookout" FontSize="18" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Foreground="{DynamicResource TextBright}"/>
        <TextBlock x:Name="VersionLabel" FontSize="14"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}"/>
        <TextBlock Text="SQL Server management &amp; version control"
                   FontSize="12" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}"/>

        <TextBlock Text="© 2025–2026 Ömer Vaner"
                   FontSize="11" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondary}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
            <Button x:Name="GitHubButton" Content="GitHub Releases"
                    Classes="btn-secondary" Padding="16,8" Cursor="Hand"/>
            <Button x:Name="CloseButton" Content="Close"
                    Classes="btn-secondary" Padding="16,8" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
