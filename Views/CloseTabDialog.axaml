<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.CloseTabDialog"
        Title="Unsaved Changes"
        Width="400" Height="170"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="28,24">
        <TextBlock x:Name="MessageText" Grid.Row="0"
                   TextWrapping="Wrap" VerticalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource TextPrimary}"/>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel"
                    Classes="btn-secondary" Padding="0,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,0,5,0"/>
            <Button x:Name="DontSaveButton" Grid.Column="1" Content="Don't Save"
                    Classes="btn-danger" Padding="0,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="5,0"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save"
                    Classes="btn-primary" Padding="0,8"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</Window>
