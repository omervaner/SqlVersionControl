<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.CloseTabDialog"
        Title="Unsaved Changes"
        Width="380" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <TextBlock x:Name="MessageText" Grid.Row="0"
                   TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="15,8"/>
            <Button x:Name="DontSaveButton" Content="Don't Save" Padding="15,8"
                    Background="#e63946" Foreground="White"/>
            <Button x:Name="SaveButton" Content="Save" Padding="15,8"
                    Background="#2a6e4e" Foreground="White" IsEnabled="False"
                    ToolTip.Tip="Available after Task 7 (Saved Queries)"/>
        </StackPanel>
    </Grid>
</Window>
