<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.SettingsDialog"
        Title="Settings"
        Width="500" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

            <!-- === Appearance === -->
            <TextBlock Text="Appearance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>

            <!-- Theme -->
            <StackPanel Spacing="8">
                <TextBlock Text="Theme" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="Theme"/>
                    <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="Theme"/>
                </StackPanel>
            </StackPanel>

            <!-- Grid Row Height -->
            <StackPanel Spacing="8">
                <TextBlock Text="Grid Row Height" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumericUpDown x:Name="GridRowHeightUpDown"
                                   Minimum="20" Maximum="32" Value="22"
                                   Width="100" FormatString="0" Increment="1"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="{DynamicResource TextDisabled}"/>
                </StackPanel>
            </StackPanel>

            <!-- Font Size -->
            <StackPanel Spacing="8">
                <TextBlock Text="Font Size" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="FontSizeCombo" MinWidth="100">
                        <ComboBoxItem Content="10" Tag="10"/>
                        <ComboBoxItem Content="11" Tag="11"/>
                        <ComboBoxItem Content="12" Tag="12"/>
                        <ComboBoxItem Content="13" Tag="13"/>
                        <ComboBoxItem Content="14" Tag="14"/>
                        <ComboBoxItem Content="16" Tag="16"/>
                        <ComboBoxItem Content="18" Tag="18"/>
                    </ComboBox>
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="{DynamicResource TextDisabled}"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,4"/>

            <!-- === Version History === -->
            <TextBlock Text="Version History" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>

            <StackPanel Spacing="8">
                <TextBlock Text="DDL Audit Source" FontWeight="SemiBold"/>
                <TextBlock Text="Database and table where DDL changes are logged. Leave empty to disable version tracking."
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="Database" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DdlAuditDatabaseTextBox" Watermark="e.g. VMAuditDb"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                        <TextBlock Text="Table Name" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox x:Name="DdlAuditTableTextBox" Watermark="e.g. dbo.DDL_Log"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,4"/>

            <!-- === General === -->
            <TextBlock Text="General" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>

            <!-- Max Recent Connections -->
            <StackPanel Spacing="8">
                <TextBlock Text="Max Recent Connections" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <NumericUpDown x:Name="MaxConnectionsUpDown"
                                   Minimum="1" Maximum="20" Value="5"
                                   Width="100" FormatString="0"/>
                    <TextBlock Text="connections" VerticalAlignment="Center" Foreground="{DynamicResource TextDisabled}"/>
                </StackPanel>
            </StackPanel>

            <!-- Data Folder -->
            <StackPanel Spacing="8">
                <TextBlock Text="Data Folder" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="DataFolderTextBox" Grid.Column="0"
                             IsReadOnly="True" Margin="0,0,10,0"/>
                    <Button x:Name="BrowseFolderButton" Grid.Column="1"
                            Content="Browse..." Padding="10,5"/>
                </Grid>
                <TextBlock x:Name="FolderHintText" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Height="1" Background="{DynamicResource BorderDefault}" Margin="0,4"/>

            <!-- === Git Integration === -->
            <TextBlock Text="Git Integration" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}"/>

            <StackPanel Spacing="8">
                <TextBlock Text="Export Path" FontWeight="SemiBold"/>
                <TextBlock Text="Export all object definitions as .sql files to this folder."
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="GitExportPathTextBox" Grid.Column="0"
                             IsReadOnly="True" Margin="0,0,10,0" Watermark="Not configured"/>
                    <Button x:Name="BrowseGitFolderButton" Grid.Column="1"
                            Content="Browse..." Padding="10,5"/>
                </Grid>
                <CheckBox x:Name="IncludeSystemDbsCheckBox" Content="Include system databases"
                          Margin="0,4,0,0"/>
                <Button x:Name="ExportNowButton" Content="Export Now"
                        Classes="btn-primary" Padding="16,8" HorizontalAlignment="Left"
                        Margin="0,4,0,0"/>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- Buttons + Version -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
            <TextBlock x:Name="VersionLabel" Grid.Column="0"
                       FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="CancelButton" Content="Cancel" Classes="btn-secondary" Padding="16,8"/>
                <Button x:Name="SaveButton" Content="Save" Classes="btn-primary" Padding="16,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
