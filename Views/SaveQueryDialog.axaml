<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.SaveQueryDialog"
        Title="Save Query"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="Query Name:" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Watermark="Enter query name..."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="5" Margin="0,12,0,0">
            <TextBlock Text="Database:" FontWeight="SemiBold"/>
            <TextBlock x:Name="DatabaseLabel" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Classes="btn-secondary" Padding="16,8"/>
            <Button x:Name="SaveButton" Content="Save" Classes="btn-primary" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
