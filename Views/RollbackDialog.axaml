<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.RollbackDialog"
        Title="Confirm Rollback"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Rollback Confirmation" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBright}"/>
            <TextBlock Name="WarningText" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Preview -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,16,0,0">
            <TextBlock Grid.Row="0" Text="This ALTER statement will be executed:"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Grid.Row="1" Background="{DynamicResource EditorBackground}" CornerRadius="2">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock Name="PreviewText"
                               FontFamily="Consolas,Menlo,Monaco,monospace"
                               FontSize="11"
                               Foreground="{DynamicResource TextPrimary}"
                               Padding="10"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
            <Button Name="CancelButton" Content="Cancel" Classes="btn-secondary" Padding="20,8"/>
            <Button Name="ConfirmButton" Content="Execute Rollback"
                    Classes="btn-danger" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
