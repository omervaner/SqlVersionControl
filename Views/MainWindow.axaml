<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlVersionControl.ViewModels"
        xmlns:views="using:SqlVersionControl.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="SqlVersionControl.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lookout"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="28">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Title Bar: Menu + Color Stripe + Tab Row -->
        <Border Grid.Row="0" x:Name="TitleBarBorder" Background="{DynamicResource TitleBarBackground}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Menu Bar + View Tabs (merged single row) -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <!-- Menus (left) -->
                    <Menu Grid.Column="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                          Margin="80,0,0,0">
                        <MenuItem Header="_File">
                            <MenuItem x:Name="MenuNewQuery" Header="New Query" InputGesture="Ctrl+N"/>
                            <Separator/>
                            <MenuItem x:Name="MenuOpenFile" Header="Open File..." InputGesture="Ctrl+O"/>
                            <MenuItem x:Name="MenuSave" Header="Save" InputGesture="Ctrl+S"/>
                            <MenuItem x:Name="MenuSaveAs" Header="Save As..." InputGesture="Ctrl+Shift+S"/>
                            <Separator/>
                            <MenuItem x:Name="MenuChangeDb" Header="Change Connection..."/>
                            <MenuItem x:Name="MenuManageConnections" Header="Manage Connections..." InputGesture="Ctrl+Shift+M"/>
                            <Separator/>
                            <MenuItem x:Name="MenuExportGit" Header="Export to Git..."/>
                            <Separator/>
                            <MenuItem x:Name="MenuRecentFiles" Header="Recent Files"/>
                            <MenuItem x:Name="MenuQueryHistory" Header="Query History"/>
                            <Separator/>
                            <MenuItem x:Name="MenuExit" Header="Exit"/>
                        </MenuItem>
                        <MenuItem Header="_Edit">
                            <MenuItem x:Name="MenuUndo" Header="Undo" InputGesture="Ctrl+Z"/>
                            <MenuItem x:Name="MenuRedo" Header="Redo" InputGesture="Ctrl+Y"/>
                            <Separator/>
                            <MenuItem x:Name="MenuCut" Header="Cut" InputGesture="Ctrl+X"/>
                            <MenuItem x:Name="MenuCopy" Header="Copy" InputGesture="Ctrl+C"/>
                            <MenuItem x:Name="MenuPaste" Header="Paste" InputGesture="Ctrl+V"/>
                            <Separator/>
                            <MenuItem x:Name="MenuFind" Header="Find..." InputGesture="Ctrl+F"/>
                            <MenuItem x:Name="MenuReplace" Header="Replace..." InputGesture="Ctrl+H"/>
                            <Separator/>
                            <MenuItem x:Name="MenuComment" Header="Comment Lines" InputGesture="Ctrl+K"/>
                            <MenuItem x:Name="MenuUncomment" Header="Uncomment Lines" InputGesture="Ctrl+L"/>
                            <Separator/>
                            <MenuItem x:Name="MenuToggleWordWrap" Header="Toggle Word Wrap" InputGesture="Alt+Z"/>
                        </MenuItem>
                        <MenuItem Header="_Tools">
                            <MenuItem x:Name="MenuFormatSql" Header="Format SQL" InputGesture="Ctrl+Shift+F"/>
                            <MenuItem x:Name="MenuSqlQuoter" Header="SQL Quoter"/>
                            <MenuItem x:Name="MenuTextCompare" Header="Text Compare"/>
                            <Separator/>
                            <MenuItem x:Name="MenuIndexAnalysis" Header="Index Analysis"/>
                        </MenuItem>
                        <MenuItem Header="_Help">
                            <MenuItem x:Name="MenuKeyboardShortcuts" Header="Keyboard Shortcuts"/>
                            <Separator/>
                            <MenuItem x:Name="MenuAbout" Header="About..."/>
                            <MenuItem x:Name="MenuCheckUpdates" Header="Check for Updates..."/>
                        </MenuItem>
                    </Menu>

                    <!-- Flexible space (Column 1 is star-sized) -->

                    <!-- View Tabs + Settings (right-aligned) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                        <RadioButton x:Name="QueryEditorTab" GroupName="Tabs" IsChecked="True"
                                     Classes="TabButton" Content="Editor"/>
                        <RadioButton x:Name="VersionHistoryTab" GroupName="Tabs"
                                     Classes="TabButton" Content="History"/>
                        <RadioButton x:Name="CompareTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Compare"/>
                        <RadioButton x:Name="PlanTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Exec Plan"/>
                        <RadioButton x:Name="ActivityTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Activity"/>
                        <RadioButton x:Name="TraceTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Trace"/>
                        <!-- Settings (tab-styled button, separated) -->
                        <Border Width="1" Margin="8,6"
                                Background="{DynamicResource BorderDefault}"/>
                        <Button x:Name="SettingsButton"
                                Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                                Padding="16,6" Margin="0"
                                FontSize="12"
                                ToolTip.Tip="Settings"
                                Cursor="Hand"
                                Content="Settings"/>
                    </StackPanel>
                </Grid>

                <!-- Connection Color Stripe -->
                <Border Grid.Row="1" x:Name="ConnectionStripe" Height="3"
                        Background="{DynamicResource ConnectionStripeColor}" IsVisible="False"/>
            </Grid>
        </Border>

        <!-- Update Notification Bar (hidden by default) -->
        <Border Grid.Row="1" x:Name="UpdateBar" IsVisible="False"
                Background="{DynamicResource ButtonToggleActive}" Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" x:Name="UpdateText"
                           Text="A new version is available"
                           Foreground="White" FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="UpdateNowButton"
                        Content="Update Now" Padding="12,4"
                        Background="White" Foreground="{DynamicResource ButtonToggleActive}"
                        FontWeight="Bold" FontSize="11"
                        Cursor="Hand" Margin="8,0"/>
                <Button Grid.Column="2" x:Name="UpdateLaterButton"
                        Content="Later" Padding="8,4"
                        Background="Transparent" Foreground="White"
                        FontSize="11" Cursor="Hand"
                        BorderThickness="1" BorderBrush="White"/>
            </Grid>
        </Border>

        <!-- Tab Content -->
        <Grid Grid.Row="2">
            <!-- Query Editor Tab -->
            <views:QueryEditorHost IsVisible="{Binding #QueryEditorTab.IsChecked}" x:Name="QueryEditorHostControl"/>

            <!-- Version History Tab -->
            <Grid IsVisible="{Binding #VersionHistoryTab.IsChecked}" RowDefinitions="Auto,*,Auto">
                <!-- Top Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="15,10">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <!-- Connection selector for History view -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="HistoryConnectionDot" Width="8" Height="8"
                                     VerticalAlignment="Center" Fill="{DynamicResource AccentBlue}"/>
                            <Button x:Name="HistoryConnectionButton" Content="Connection"
                                    Classes="btn-secondary" Padding="8,4" FontSize="11"
                                    ToolTip.Tip="Change History connection" Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="15,0,0,0">
                            <TextBlock Text="Database:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Databases}"
                                      SelectedItem="{Binding SelectedDatabase}"
                                      MinWidth="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0">
                            <TextBox x:Name="VersionHistorySearchBox"
                                     Text="{Binding SearchText}"
                                     Watermark="Search objects..."
                                     Width="200"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10">
                            <Button Content="Sync" Classes="btn-primary"
                                    Command="{Binding SyncCommand}"
                                    ToolTip.Tip="Sync new changes from DDL log"/>
                            <Button Content="Refresh" Classes="btn-secondary"
                                    Command="{Binding RefreshCommand}"/>
                            <Button x:Name="DependenciesButton" Content="Dependencies"
                                    Classes="btn-toggle"
                                    ToolTip.Tip="Show dependencies for selected object"
                                    IsVisible="{Binding SelectedObject, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="5" Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Row="1" ColumnDefinitions="250,Auto,*">
                    <!-- Left Panel: Object Browser -->
                    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Normal header -->
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10"
                                    IsVisible="{Binding !IsDependencyMode}">
                                <TextBlock Text="Object Browser" FontWeight="SemiBold"/>
                            </Border>
                            <!-- Dependency mode header -->
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10"
                                    IsVisible="{Binding IsDependencyMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                               Text="{Binding DependencySourceName, StringFormat='Deps of {0}'}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Back" Classes="btn-secondary"
                                            Command="{Binding BackFromDependenciesCommand}"
                                            Padding="8,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Objects}"
                                     SelectedItem="{Binding SelectedObject}"
                                     Padding="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Panel>
                                            <!-- Section header (dependency mode) -->
                                            <TextBlock Text="{Binding SectionTitle}" FontWeight="Bold"
                                                       FontSize="12" Foreground="{DynamicResource AccentBlue}" Margin="0,6,0,2"
                                                       IsVisible="{Binding IsSectionHeader}"/>
                                            <!-- Normal object item -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding !IsSectionHeader}">
                                                <TextBlock Text="{Binding TypeIcon}" FontFamily="Segoe UI Symbol"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding ObjectName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="(in code)" FontSize="10" Foreground="{DynamicResource WarningSeverityWarning}"
                                                                   FontStyle="Italic" VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsCodeMatch}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayInfo}" FontSize="11"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Resizable Splitter -->
                    <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderDefault}" ResizeDirection="Columns"/>

                    <!-- Right Panel: Recent Changes + Diff -->
                    <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
                        <!-- Recent Changes -->
                        <Grid Grid.Row="0" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10">
                                <TextBlock Text="Recent Changes" FontWeight="SemiBold"/>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding RecentChanges}"
                                      SelectedItem="{Binding SelectedChange}"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="*"/>
                                    <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="80"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="70"/>
                                    <DataGridTextColumn Header="Changed By" Binding="{Binding ChangedBy}" Width="100"/>
                                    <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="100"/>
                                    <DataGridTextColumn Header="When" Binding="{Binding TimeAgo}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Splitter -->
                        <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderDefault}" ResizeDirection="Rows"/>

                        <!-- Diff View -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                            <!-- Version Selectors -->
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10">
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Left:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding Versions}"
                                                  SelectedItem="{Binding LeftVersion}"
                                                  MinWidth="200">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VersionLabel}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Copy" Classes="btn-secondary"
                                                Command="{Binding CopyLeftCodeCommand}"
                                                Padding="8,4"
                                                ToolTip.Tip="Copy left definition to clipboard"
                                                IsVisible="{Binding LeftVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Rollback to Left"
                                            Classes="btn-danger"
                                            Command="{Binding RollbackCommand}"
                                            IsVisible="{Binding LeftVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <TextBlock Text="Right:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding Versions}"
                                                  SelectedItem="{Binding RightVersion}"
                                                  MinWidth="200">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VersionLabel}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Copy" Classes="btn-secondary"
                                                Command="{Binding CopyRightCodeCommand}"
                                                Padding="8,4"
                                                ToolTip.Tip="Copy right definition to clipboard"
                                                IsVisible="{Binding RightVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Side by Side Diff View -->
                            <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel}"
                                            x:Name="MainDiffView"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="{DynamicResource ToolbarBackground}" Padding="10,5">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                </Border>
            </Grid>

            <!-- Compare Databases Tab -->
            <views:CompareView IsVisible="{Binding #CompareTab.IsChecked}" x:Name="CompareViewControl"/>

            <!-- Execution Plan Tab -->
            <views:PlanView IsVisible="{Binding #PlanTab.IsChecked}" x:Name="PlanViewControl"/>

            <!-- Activity Monitor Tab -->
            <views:ActivityView IsVisible="{Binding #ActivityTab.IsChecked}" x:Name="ActivityViewControl"/>

            <!-- Query Trace Tab -->
            <views:TraceView IsVisible="{Binding #TraceTab.IsChecked}" x:Name="TraceViewControl"/>
        </Grid>

        <!-- Reconnection Overlay (z-order: on top of everything) -->
        <Panel Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource OverlayBackground}"
               IsVisible="False" x:Name="ReconnectOverlay">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <TextBlock x:Name="ReconnectText" Text="Reconnecting..."
                           Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ReconnectProgress" IsIndeterminate="True"
                             Width="250" Foreground="{DynamicResource AccentBlue}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Button x:Name="RetryButton" Content="Retry"
                            Classes="btn-secondary" Padding="20,8"
                            IsVisible="False" Cursor="Hand"/>
                    <Button x:Name="DismissButton" Content="Dismiss"
                            Classes="btn-secondary" Padding="20,8"
                            Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="Press Escape to dismiss" Foreground="{DynamicResource TextDisabled}"
                           FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Panel>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                Padding="8,2" Height="24">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <!-- Connection indicator -->
                <Ellipse x:Name="ConnectionDot" Grid.Column="0"
                         Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{DynamicResource DisconnectedDot}"/>
                <TextBlock x:Name="ConnectionText" Grid.Column="1"
                           Text="Disconnected" Margin="6,0,0,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- Quick-switch buttons -->
                <StackPanel x:Name="QuickSwitchPanel" Grid.Column="2"
                            Orientation="Horizontal" Spacing="4" Margin="12,0"
                            VerticalAlignment="Center"/>

                <!-- Separator -->
                <TextBlock Grid.Column="3" Text="|" Margin="12,0"
                           Foreground="{DynamicResource TextDisabled}" FontSize="11"
                           VerticalAlignment="Center"
                           x:Name="QueryStatusSeparator" IsVisible="False"/>

                <!-- Query timing (permanent, only on Query Editor tab) -->
                <TextBlock x:Name="QueryStatusText" Grid.Column="4"
                           Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" IsVisible="False"/>

                <!-- Query flash message (colored, fades after 3s) -->
                <TextBlock x:Name="QueryFlashText" Grid.Column="5"
                           Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="False"/>

                <!-- Cursor position (Ln/Col) -->
                <TextBlock x:Name="CursorPositionText" Grid.Column="6"
                           Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="False"/>

                <!-- General status (right-aligned) -->
                <TextBlock Grid.Column="7" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="RadioButton.TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,2"
                            BorderBrush="Transparent"
                            x:Name="PART_Border">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.TabButton:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="RadioButton.TabButton:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
        </Style>
        <Style Selector="RadioButton.TabButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button#SettingsButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <Style Selector="Button#SettingsButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- Menu bar styling -->
        <Style Selector="Menu > MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Menu > MenuItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Styles>
</Window>
