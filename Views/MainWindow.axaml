<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlVersionControl.ViewModels"
        xmlns:views="using:SqlVersionControl.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="SqlVersionControl.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SQL Version Control"
        Width="1200" Height="700"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title Bar: Menu + Tab Row -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Menu Bar -->
                <Menu Grid.Row="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                      Margin="80,4,0,0">
                    <MenuItem Header="_File">
                        <MenuItem x:Name="MenuNewQuery" Header="New Query" InputGesture="Ctrl+N"/>
                        <Separator/>
                        <MenuItem x:Name="MenuOpenFile" Header="Open File..." InputGesture="Ctrl+O"/>
                        <MenuItem x:Name="MenuSave" Header="Save" InputGesture="Ctrl+S"/>
                        <MenuItem x:Name="MenuSaveAs" Header="Save As..." InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem x:Name="MenuRecentFiles" Header="Recent Files"/>
                        <Separator/>
                        <MenuItem x:Name="MenuExit" Header="Exit"/>
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem x:Name="MenuUndo" Header="Undo" InputGesture="Ctrl+Z"/>
                        <MenuItem x:Name="MenuRedo" Header="Redo" InputGesture="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem x:Name="MenuCut" Header="Cut" InputGesture="Ctrl+X"/>
                        <MenuItem x:Name="MenuCopy" Header="Copy" InputGesture="Ctrl+C"/>
                        <MenuItem x:Name="MenuPaste" Header="Paste" InputGesture="Ctrl+V"/>
                        <Separator/>
                        <MenuItem x:Name="MenuFind" Header="Find..." InputGesture="Ctrl+F"/>
                        <MenuItem x:Name="MenuReplace" Header="Replace..." InputGesture="Ctrl+H"/>
                    </MenuItem>
                    <MenuItem Header="_Query">
                        <MenuItem x:Name="MenuRun" Header="Run" InputGesture="F5"/>
                        <MenuItem x:Name="MenuStop" Header="Stop"/>
                        <Separator/>
                        <MenuItem x:Name="MenuChangeDb" Header="Change Database..."/>
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem x:Name="MenuAbout" Header="About..."/>
                        <MenuItem x:Name="MenuCheckUpdates" Header="Check for Updates..."/>
                    </MenuItem>
                </Menu>

                <!-- App Tab Row -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="80,0,0,0">
                        <RadioButton x:Name="QueryEditorTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Query Editor"/>
                        <RadioButton x:Name="VersionHistoryTab" GroupName="Tabs" IsChecked="True"
                                     Classes="TabButton" Content="Version History"/>
                        <RadioButton x:Name="CompareTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Compare Databases"/>
                        <RadioButton x:Name="PlanTab" GroupName="Tabs"
                                     Classes="TabButton" Content="Execution Plan"/>
                    </StackPanel>
                    <Button x:Name="SettingsButton" Grid.Column="1"
                            Background="Transparent" Foreground="{DynamicResource TextSecondary}"
                            Padding="15,10" Margin="0,0,10,0"
                            ToolTip.Tip="Settings"
                            Cursor="Hand">
                        <TextBlock Text="&#x2699;" FontSize="18"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Tab Content -->
        <Grid Grid.Row="1">
            <!-- Query Editor Tab -->
            <views:QueryEditorHost IsVisible="{Binding #QueryEditorTab.IsChecked}" x:Name="QueryEditorHostControl"/>

            <!-- Version History Tab -->
            <Grid IsVisible="{Binding #VersionHistoryTab.IsChecked}" RowDefinitions="Auto,*,Auto">
                <!-- Top Toolbar -->
                <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="15,10">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Database:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Databases}"
                                      SelectedItem="{Binding SelectedDatabase}"
                                      MinWidth="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0">
                            <TextBox x:Name="VersionHistorySearchBox"
                                     Text="{Binding SearchText}"
                                     Watermark="Search objects..."
                                     Width="200"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                            <Button Content="Sync" Classes="btn-primary"
                                    Command="{Binding SyncCommand}"
                                    ToolTip.Tip="Sync new changes from DDL log"/>
                            <Button Content="Refresh" Classes="btn-secondary"
                                    Command="{Binding RefreshCommand}"/>
                            <Button x:Name="DependenciesButton" Content="Dependencies"
                                    Classes="btn-toggle"
                                    ToolTip.Tip="Show dependencies for selected object"
                                    IsVisible="{Binding SelectedObject, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4" Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Row="1" ColumnDefinitions="250,Auto,*">
                    <!-- Left Panel: Object Browser -->
                    <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Normal header -->
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10"
                                    IsVisible="{Binding !IsDependencyMode}">
                                <TextBlock Text="Object Browser" FontWeight="SemiBold"/>
                            </Border>
                            <!-- Dependency mode header -->
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10"
                                    IsVisible="{Binding IsDependencyMode}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold"
                                               Text="{Binding DependencySourceName, StringFormat='Deps of {0}'}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Back" Classes="btn-secondary"
                                            Command="{Binding BackFromDependenciesCommand}"
                                            Padding="8,2" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Objects}"
                                     SelectedItem="{Binding SelectedObject}"
                                     Padding="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Panel>
                                            <!-- Section header (dependency mode) -->
                                            <TextBlock Text="{Binding SectionTitle}" FontWeight="Bold"
                                                       FontSize="12" Foreground="{DynamicResource AccentBlue}" Margin="0,6,0,2"
                                                       IsVisible="{Binding IsSectionHeader}"/>
                                            <!-- Normal object item -->
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        IsVisible="{Binding !IsSectionHeader}">
                                                <TextBlock Text="{Binding TypeIcon}" FontFamily="Segoe UI Symbol"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding ObjectName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="(in code)" FontSize="10" Foreground="{DynamicResource WarningSeverityWarning}"
                                                                   FontStyle="Italic" VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsCodeMatch}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayInfo}" FontSize="11"
                                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Resizable Splitter -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" ResizeDirection="Columns"/>

                    <!-- Right Panel: Recent Changes + Diff -->
                    <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
                        <!-- Recent Changes -->
                        <Grid Grid.Row="0" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10">
                                <TextBlock Text="Recent Changes" FontWeight="SemiBold"/>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding RecentChanges}"
                                      SelectedItem="{Binding SelectedChange}"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      CanUserResizeColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="*"/>
                                    <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="80"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="70"/>
                                    <DataGridTextColumn Header="Changed By" Binding="{Binding ChangedBy}" Width="100"/>
                                    <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="100"/>
                                    <DataGridTextColumn Header="When" Binding="{Binding TimeAgo}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Splitter -->
                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" ResizeDirection="Rows"/>

                        <!-- Diff View -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                            <!-- Version Selectors -->
                            <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10">
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Left:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding Versions}"
                                                  SelectedItem="{Binding LeftVersion}"
                                                  MinWidth="200">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VersionLabel}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Copy" Classes="btn-secondary"
                                                Command="{Binding CopyLeftCodeCommand}"
                                                Padding="8,4"
                                                ToolTip.Tip="Copy left definition to clipboard"
                                                IsVisible="{Binding LeftVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Rollback to Left"
                                            Classes="btn-danger"
                                            Command="{Binding RollbackCommand}"
                                            IsVisible="{Binding LeftVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                        <TextBlock Text="Right:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding Versions}"
                                                  SelectedItem="{Binding RightVersion}"
                                                  MinWidth="200">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VersionLabel}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="Copy" Classes="btn-secondary"
                                                Command="{Binding CopyRightCodeCommand}"
                                                Padding="8,4"
                                                ToolTip.Tip="Copy right definition to clipboard"
                                                IsVisible="{Binding RightVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Side by Side Diff View -->
                            <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel}"
                                            x:Name="MainDiffView"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" Background="{DynamicResource ToolbarBackground}" Padding="10,5">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                </Border>
            </Grid>

            <!-- Compare Databases Tab -->
            <views:CompareView IsVisible="{Binding #CompareTab.IsChecked}" x:Name="CompareViewControl"/>

            <!-- Execution Plan Tab -->
            <views:PlanView IsVisible="{Binding #PlanTab.IsChecked}" x:Name="PlanViewControl"/>
        </Grid>

        <!-- Reconnection Overlay (z-order: on top of everything) -->
        <Panel Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource OverlayBackground}"
               IsVisible="False" x:Name="ReconnectOverlay">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                <TextBlock x:Name="ReconnectText" Text="Reconnecting..."
                           Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <ProgressBar x:Name="ReconnectProgress" IsIndeterminate="True"
                             Width="250" Foreground="{DynamicResource AccentBlue}"/>
                <Button x:Name="RetryButton" Content="Click to Retry"
                        Classes="btn-secondary" Padding="20,8"
                        HorizontalAlignment="Center" IsVisible="False"
                        Cursor="Hand"/>
            </StackPanel>
        </Panel>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource TitleBarBackground}"
                BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                Padding="12,4" Height="26">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <!-- Connection indicator -->
                <Ellipse x:Name="ConnectionDot" Grid.Column="0"
                         Width="8" Height="8" VerticalAlignment="Center"
                         Fill="#e74c3c"/>
                <TextBlock x:Name="ConnectionText" Grid.Column="1"
                           Text="Disconnected" Margin="6,0,0,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- Separator -->
                <TextBlock Grid.Column="2" Text="|" Margin="12,0"
                           Foreground="{DynamicResource TextDisabled}" FontSize="11"
                           VerticalAlignment="Center"
                           x:Name="QueryStatusSeparator" IsVisible="False"/>

                <!-- Query status (only on Query Editor tab) -->
                <TextBlock x:Name="QueryStatusText" Grid.Column="3"
                           Text="" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" IsVisible="False"/>

                <!-- General status (right-aligned) -->
                <TextBlock Grid.Column="5" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="RadioButton.TabButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0,0,0,3"
                            BorderBrush="Transparent"
                            x:Name="PART_Border">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.TabButton:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="RadioButton.TabButton:checked /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
        </Style>
        <Style Selector="RadioButton.TabButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button#SettingsButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- Menu bar styling -->
        <Style Selector="Menu > MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style Selector="Menu > MenuItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Styles>
</Window>
