<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             xmlns:conv="using:SqlVersionControl.Converters"
             xmlns:views="using:SqlVersionControl.Views"
             x:Class="SqlVersionControl.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">

    <UserControl.Resources>
        <conv:MessageTypeToColorConverter x:Key="MessageTypeToColor"/>
    </UserControl.Resources>

    <!-- Editor (top) + Results (bottom) + Cell Detail — toolbar merged into tab strip in QueryEditorHost -->
    <Grid x:Name="EditorResultsGrid" RowDefinitions="*,Auto,*,Auto">
            <!-- SQL Editor -->
            <Border Grid.Row="0">
                <Panel>
                    <ae:TextEditor x:Name="SqlEditor"
                                   Focusable="True"
                                   IsReadOnly="False"
                                   FontFamily="Consolas, Menlo, Monaco, monospace"
                                   FontSize="12"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="EditorPlaceholder"
                               Text="Write your SQL query here — press F5 to execute"
                               FontFamily="Consolas, Menlo, Monaco, monospace"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Opacity="0.5"
                               Margin="52,4,0,0"
                               IsHitTestVisible="False"/>
                </Panel>
            </Border>

            <!-- Row 1: Splitter (direct child of EditorResultsGrid) -->
            <GridSplitter Grid.Row="1" x:Name="ResultsSplitter"
                          HorizontalAlignment="Stretch" Height="6"
                          Background="{DynamicResource BorderDefault}"
                          ResizeDirection="Rows"/>
            <Button Grid.Row="1" x:Name="ResultsCollapseButton"
                    Content="&#x25BC;" FontSize="7"
                    Width="24" Height="12"
                    Padding="0" Margin="0"
                    MinWidth="0" MinHeight="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip.Tip="Toggle Results Panel (Ctrl+J)"
                    ZIndex="1"/>

            <!-- Results Panel -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <!-- Result Tabs Header + Edit Mode Toggle + Edit Buttons -->
                <Border Grid.Row="0" x:Name="ResultsTabBar" Background="{DynamicResource PanelHeaderBackground}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1"
                        Padding="5,0" Height="28">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel x:Name="ResultTabHeaders" Grid.Column="0" Orientation="Horizontal" Spacing="2"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <!-- Edit mode buttons (visible only in edit mode) -->
                            <TextBlock x:Name="PendingChangesText" Text="No changes"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       FontSize="11" Margin="4,0" IsVisible="False"/>

                            <Button Content="+ Row" x:Name="AddRowButton"
                                    Classes="btn-secondary"
                                    Command="{Binding AddNewRowCommand}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Add a new empty row"/>

                            <Button Content="Show SQL" x:Name="ShowSqlButton"
                                    Classes="btn-secondary"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Preview DML statements"/>

                            <Button Content="Apply" x:Name="ApplyButton"
                                    Classes="btn-primary"
                                    Command="{Binding ApplyChangesCommand}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Execute pending changes"/>

                            <Button Content="Cancel" x:Name="CancelButton"
                                    Classes="btn-danger"
                                    Command="{Binding CancelChangesCommand}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Discard pending changes"/>

                            <!-- Separator between edit buttons and Export/Edit -->
                            <Border x:Name="EditSeparator" Width="1" Height="20"
                                    Background="{DynamicResource BorderDefault}"
                                    Margin="4,0" VerticalAlignment="Center" IsVisible="False"/>

                            <!-- Always-visible buttons -->
                            <Button x:Name="ExportButton"
                                    Content="Export"
                                    Classes="btn-secondary"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    ToolTip.Tip="Export results to CSV"/>
                            <!-- Export progress (hidden by default) -->
                            <StackPanel x:Name="ExportProgressPanel" Orientation="Horizontal"
                                        Spacing="3" VerticalAlignment="Center" IsVisible="False">
                                <ProgressBar x:Name="ExportProgressBar"
                                             Width="80" Height="6" Minimum="0" Maximum="100"
                                             Foreground="{DynamicResource AccentBlue}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExportProgressText" Text="0%"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ExportCancelButton" Content="&#xd7;"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Padding="3,0" FontSize="12"
                                        MinWidth="0" MinHeight="0" Height="18"
                                        BorderThickness="0" Cursor="Hand"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Cancel export"/>
                            </StackPanel>
                            <!-- Edit Mode Toggle -->
                            <Button x:Name="EditModeButton"
                                    Content="Edit"
                                    Classes="btn-secondary"
                                    Command="{Binding ToggleEditModeCommand}"
                                    IsVisible="{Binding CanEditMode}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    ToolTip.Tip="Edit result rows"/>
                            <!-- Cell Detail Panel Toggle -->
                            <Button x:Name="CellDetailToggleButton"
                                    Content="👁"
                                    Classes="btn-secondary"
                                    Padding="6,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    ToolTip.Tip="Toggle cell detail panel"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Result Content -->
                <Panel Grid.Row="1">
                    <!-- Results DataGrid -->
                    <DataGrid x:Name="ResultsGrid"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              HeadersVisibility="All"
                              GridLinesVisibility="All"
                              BorderThickness="0"
                              Margin="0,-1,0,0"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              CanUserReorderColumns="True"
                              FrozenColumnCount="0">
                        <DataGrid.Styles>
                            <Style Selector="DataGridCell">
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridCell TextBlock">
                                <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                                <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                <Setter Property="Margin" Value="6,0"/>
                            </Style>
                            <Style Selector="DataGridCell.numericCell TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                            <Style Selector="DataGridCell.numericCell TextBox">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                            <Style Selector="DataGridCell TextBox">
                                <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                                <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style Selector="DataGridColumnHeader">
                                <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridRow">
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridRow:selected">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="DataGridCell:current">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.Styles>
                    </DataGrid>

                    <!-- Stacked Results (multiple result sets, read-only) -->
                    <Grid x:Name="StackedResultsPanel" IsVisible="False">
                        <!-- RowDefinitions built dynamically in ShowStackedResults() -->
                    </Grid>

                    <!-- Messages Panel -->
                    <Border x:Name="MessagesPanel" IsVisible="False"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <ScrollViewer>
                            <ItemsControl x:Name="MessagesItemsControl"
                                          ItemsSource="{Binding Messages}"
                                          Padding="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <SelectableTextBlock Text="{Binding Text}"
                                                             Foreground="{Binding Type, Converter={StaticResource MessageTypeToColor}}"
                                                             FontFamily="Consolas, Menlo, Monaco, monospace"
                                                             FontSize="12" TextWrapping="Wrap"
                                                             Margin="0,1"
                                                             Tag="{Binding}"
                                                             DoubleTapped="OnMessageDoubleTapped">
                                            <SelectableTextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy Message" Click="OnCopyMessageClick" Tag="{Binding Text}"/>
                                                </ContextMenu>
                                            </SelectableTextBlock.ContextMenu>
                                        </SelectableTextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Trace Results Panel -->
                    <Grid x:Name="TracePanel" IsVisible="False">
                        <Grid RowDefinitions="*,Auto">
                            <!-- Trace events grid -->
                            <DataGrid Grid.Row="0" x:Name="TraceGrid"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      ItemsSource="{Binding TraceEvents}"
                                      SelectedItem="{Binding SelectedTraceEvent}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="40"
                                        Binding="{Binding $parent[DataGridRow].GetIndex}"/>
                                    <DataGridTextColumn Header="Statement" Width="*"
                                        Binding="{Binding SqlTextPreview}"/>
                                    <DataGridTextColumn Header="Duration" Width="85"
                                        Binding="{Binding DurationDisplay}"/>
                                    <DataGridTextColumn Header="CPU (ms)" Width="75"
                                        Binding="{Binding CpuMs}"/>
                                    <DataGridTextColumn Header="Reads" Width="75"
                                        Binding="{Binding LogicalReads}"/>
                                    <DataGridTextColumn Header="Rows" Width="65"
                                        Binding="{Binding RowCount}"/>
                                </DataGrid.Columns>
                                <DataGrid.Styles>
                                    <Style Selector="DataGridCell TextBlock">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                    </Style>
                                    <Style Selector="DataGridRow">
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </DataGrid.Styles>
                            </DataGrid>
                            <!-- Selected trace event detail -->
                            <Border Grid.Row="1" Height="100"
                                    Background="{DynamicResource PanelHeaderBackground}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="0,1,0,0"
                                    IsVisible="{Binding SelectedTraceEvent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ScrollViewer Padding="8,6">
                                    <TextBlock Text="{Binding SelectedTraceEvent.SqlText}"
                                               FontFamily="Consolas, Menlo, Monaco, monospace"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Peek Definition panel (read-only editor with syntax highlighting) -->
                    <Grid x:Name="PeekPanel" IsVisible="False">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBackground}"
                                    Padding="8,4" Height="28">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="PeekTitle" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="&#xd7;" FontSize="14"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Padding="6,0" MinWidth="0" MinHeight="0"
                                            BorderThickness="0" Cursor="Hand"
                                            x:Name="PeekCloseButton"
                                            ToolTip.Tip="Close peek"/>
                                </Grid>
                            </Border>
                            <ae:TextEditor Grid.Row="1" x:Name="PeekEditor"
                                           IsReadOnly="True"
                                           FontFamily="Consolas, Menlo, Monaco, monospace"
                                           FontSize="12"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>

                    <!-- Execution Plan Panel (embedded PlanView) -->
                    <views:PlanView x:Name="PlanPanel" IsVisible="False"/>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyState" Text="Run a query to see results here"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14"/>
                </Panel>
            </Grid>

            <!-- Cell Detail Strip (own row, doesn't overlay results grid) -->
            <Border Grid.Row="3" x:Name="CellDetailPanel" IsVisible="False"
                    Height="80"
                    Background="{DynamicResource PanelHeaderBackground}"
                    BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Drag handle to resize -->
                    <Border Grid.Row="0" x:Name="CellDetailResizeHandle"
                            Height="4" Cursor="SizeNorthSouth"
                            Background="Transparent"/>
                    <Border Grid.Row="1" Padding="8,2" Height="22">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="CellDetailHeader" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="CellDetailCopyButton"
                                    Content="Copy" Classes="btn-secondary"
                                    Padding="8,1" FontSize="10" Height="18" MinHeight="0"
                                    Cursor="Hand" Margin="4,0"/>
                            <Button Grid.Column="2" x:Name="CellDetailCloseButton"
                                    Content="&#xd7;" Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Padding="4,0" FontSize="14" MinWidth="0" MinHeight="0"
                                    BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" Padding="8,4"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock x:Name="CellDetailText"
                                   FontFamily="Consolas, Menlo, Monaco, monospace"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
</UserControl>
