<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             x:Class="SqlVersionControl.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- Per-tab Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="10,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Database:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="DatabaseCombo"
                              ItemsSource="{Binding Databases}"
                              SelectedItem="{Binding SelectedDatabase}"
                              MinWidth="150"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RunButton" Content="Run (F5)"
                            Classes="btn-primary"
                            Command="{Binding RunQueryCommand}"
                            IsEnabled="{Binding !IsRunning}"
                            ToolTip.Tip="Execute query (F5 or Ctrl+Enter)"/>
                    <Button Content="Stop"
                            Classes="btn-danger"
                            Command="{Binding StopQueryCommand}"
                            IsEnabled="{Binding IsRunning}"
                            ToolTip.Tip="Cancel running query"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </Grid>
        </Border>

        <!-- Editor (top) + Results (bottom) -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,*">
            <!-- SQL Editor -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,0,1">
                <ae:TextEditor x:Name="SqlEditor"
                               Focusable="True"
                               IsReadOnly="False"
                               FontFamily="Consolas, Menlo, Monaco, monospace"
                               FontSize="13"
                               ShowLineNumbers="True"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                          ResizeDirection="Rows"/>

            <!-- Results Panel -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <!-- Result Tabs Header + Edit Mode Toggle + Edit Buttons -->
                <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        Padding="5,0" IsVisible="{Binding Results.Count}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel x:Name="ResultTabHeaders" Grid.Column="0" Orientation="Horizontal" Spacing="2"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <!-- Edit mode buttons (visible only in edit mode) -->
                            <TextBlock x:Name="PendingChangesText" Text="No changes"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       FontSize="12" Margin="4,0" IsVisible="False"/>

                            <Button Content="+ Row" x:Name="AddRowButton"
                                    Classes="btn-secondary"
                                    Command="{Binding AddNewRowCommand}"
                                    Padding="8,4" Margin="2,3"
                                    FontSize="12" IsVisible="False"
                                    ToolTip.Tip="Add a new empty row"/>

                            <Button Content="Show SQL" x:Name="ShowSqlButton"
                                    Classes="btn-secondary"
                                    Padding="8,4" Margin="2,3"
                                    FontSize="12" IsVisible="False"
                                    ToolTip.Tip="Preview the DML statements"/>

                            <Button Content="Apply"  x:Name="ApplyButton"
                                    Classes="btn-primary"
                                    Command="{Binding ApplyChangesCommand}"
                                    Padding="10,4" Margin="2,3"
                                    FontSize="12" IsVisible="False"
                                    ToolTip.Tip="Execute all pending changes in a transaction"/>

                            <Button Content="Cancel" x:Name="CancelButton"
                                    Classes="btn-danger"
                                    Command="{Binding CancelChangesCommand}"
                                    Padding="10,4" Margin="2,3"
                                    FontSize="12" IsVisible="False"
                                    ToolTip.Tip="Discard all pending changes"/>

                            <!-- Separator between edit buttons and Export/Edit -->
                            <Border x:Name="EditSeparator" Width="1" Height="20"
                                    Background="{DynamicResource BorderDefault}"
                                    Margin="4,0" VerticalAlignment="Center" IsVisible="False"/>

                            <!-- Always-visible buttons -->
                            <Button x:Name="ExportButton"
                                    Content="Export"
                                    Classes="btn-secondary"
                                    Padding="10,5" Margin="2,3"
                                    FontSize="12"
                                    ToolTip.Tip="Export results to Excel (.xlsx)"/>
                            <!-- Edit Mode Toggle -->
                            <Button x:Name="EditModeButton"
                                    Content="Edit"
                                    Classes="btn-secondary"
                                    Command="{Binding ToggleEditModeCommand}"
                                    IsVisible="{Binding CanEditMode}"
                                    Padding="10,5" Margin="2,3"
                                    FontSize="12"
                                    ToolTip.Tip="Toggle inline editing (requires primary key)"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Result Content -->
                <Panel Grid.Row="1">
                    <!-- Results DataGrid -->
                    <DataGrid x:Name="ResultsGrid"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              HeadersVisibility="All"
                              GridLinesVisibility="All"
                              BorderThickness="0"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Styles>
                            <Style Selector="DataGridCell">
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridCell TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                            <Style Selector="DataGridCell TextBox">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridRow">
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </DataGrid.Styles>
                        <DataGrid.RowHeight>26</DataGrid.RowHeight>
                    </DataGrid>

                    <!-- Messages Panel -->
                    <Border x:Name="MessagesPanel" IsVisible="False"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <ScrollViewer>
                            <TextBlock Text="{Binding Messages}" Padding="10"
                                       FontFamily="Consolas, Menlo, Monaco, monospace"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyState" Text="Run a query to see results here"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14"/>
                </Panel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
