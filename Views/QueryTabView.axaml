<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             x:Class="SqlVersionControl.Views.QueryTabView"
             x:DataType="vm:QueryTabViewModel">

    <!-- Editor (top) + Results (bottom) — toolbar merged into tab strip in QueryEditorHost -->
    <Grid x:Name="EditorResultsGrid" RowDefinitions="*,Auto,*">
            <!-- SQL Editor -->
            <Border Grid.Row="0">
                <ae:TextEditor x:Name="SqlEditor"
                               Focusable="True"
                               IsReadOnly="False"
                               FontFamily="Consolas, Menlo, Monaco, monospace"
                               FontSize="12"
                               ShowLineNumbers="True"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>
            </Border>

            <!-- Row 1: Splitter (direct child of EditorResultsGrid) -->
            <GridSplitter Grid.Row="1" x:Name="ResultsSplitter"
                          HorizontalAlignment="Stretch" Height="6"
                          Background="{DynamicResource BorderDefault}"
                          ResizeDirection="Rows"/>
            <Button Grid.Row="1" x:Name="ResultsCollapseButton"
                    Content="&#x25BC;" FontSize="7"
                    Width="24" Height="12"
                    Padding="0" Margin="0"
                    MinWidth="0" MinHeight="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondary}"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip.Tip="Toggle Results Panel (Ctrl+J)"
                    ZIndex="1"/>

            <!-- Results Panel -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <!-- Result Tabs Header + Edit Mode Toggle + Edit Buttons -->
                <Border Grid.Row="0" x:Name="ResultsTabBar" Background="{DynamicResource PanelHeaderBackground}"
                        Padding="5,0" Height="28" IsVisible="{Binding Results.Count}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel x:Name="ResultTabHeaders" Grid.Column="0" Orientation="Horizontal" Spacing="2"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                            <!-- Edit mode buttons (visible only in edit mode) -->
                            <TextBlock x:Name="PendingChangesText" Text="No changes"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                       FontSize="11" Margin="4,0" IsVisible="False"/>

                            <Button Content="+ Row" x:Name="AddRowButton"
                                    Classes="btn-secondary"
                                    Command="{Binding AddNewRowCommand}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Add a new empty row"/>

                            <Button Content="Show SQL" x:Name="ShowSqlButton"
                                    Classes="btn-secondary"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Preview DML statements"/>

                            <Button Content="Apply" x:Name="ApplyButton"
                                    Classes="btn-primary"
                                    Command="{Binding ApplyChangesCommand}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Execute pending changes"/>

                            <Button Content="Cancel" x:Name="CancelButton"
                                    Classes="btn-danger"
                                    Command="{Binding CancelChangesCommand}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    IsVisible="False"
                                    ToolTip.Tip="Discard pending changes"/>

                            <!-- Separator between edit buttons and Export/Edit -->
                            <Border x:Name="EditSeparator" Width="1" Height="20"
                                    Background="{DynamicResource BorderDefault}"
                                    Margin="4,0" VerticalAlignment="Center" IsVisible="False"/>

                            <!-- Always-visible buttons -->
                            <Button x:Name="ExportButton"
                                    Content="Export"
                                    Classes="btn-secondary"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    ToolTip.Tip="Export results to CSV"/>
                            <!-- Edit Mode Toggle -->
                            <Button x:Name="EditModeButton"
                                    Content="Edit"
                                    Classes="btn-secondary"
                                    Command="{Binding ToggleEditModeCommand}"
                                    IsVisible="{Binding CanEditMode}"
                                    Padding="8,2" Margin="2,2"
                                    FontSize="11" Height="22" MinHeight="0"
                                    ToolTip.Tip="Edit result rows"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Result Content -->
                <Panel Grid.Row="1">
                    <!-- Results DataGrid -->
                    <DataGrid x:Name="ResultsGrid"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              HeadersVisibility="All"
                              GridLinesVisibility="All"
                              BorderThickness="0"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.Styles>
                            <Style Selector="DataGridCell">
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridCell TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                            <Style Selector="DataGridCell TextBox">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                            <Style Selector="DataGridRow">
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </DataGrid.Styles>
                    </DataGrid>

                    <!-- Messages Panel -->
                    <Border x:Name="MessagesPanel" IsVisible="False"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <ScrollViewer>
                            <TextBlock Text="{Binding Messages}" Padding="10"
                                       FontFamily="Consolas, Menlo, Monaco, monospace"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyState" Text="Run a query to see results here"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14"/>
                </Panel>
            </Grid>
        </Grid>
</UserControl>
