<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SqlVersionControl.Views.ConfirmDialog"
        Title="Confirm"
        Width="400" Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <TextBlock x:Name="MessageText" Grid.Row="0"
                   TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Classes="btn-secondary" Padding="16,8"/>
            <Button x:Name="OkButton" Content="OK" Classes="btn-danger" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
