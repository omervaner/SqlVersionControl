<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             x:Class="SqlVersionControl.Views.TraceView"
             x:DataType="vm:TraceViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBackground}"
                Padding="12,8" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Query Trace" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBright}"/>
                    <!-- Connection picker -->
                    <ComboBox ItemsSource="{Binding ConnectionNames}"
                              SelectedItem="{Binding SelectedConnectionName}"
                              MinWidth="180" Height="26" FontSize="11" Padding="6,2"/>
                </StackPanel>

                <!-- Recording indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding State, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <!-- Red dot when recording -->
                    <Ellipse Width="10" Height="10" Fill="#e74c3c"
                             IsVisible="{Binding State, FallbackValue=False}"/>
                    <TextBlock Text="{Binding ElapsedText}" FontSize="12"
                               FontFamily="Consolas, Menlo, Monaco, monospace"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} events">
                                <Binding Path="CapturedCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main content: switches between Setup / Recording / Results -->
        <Panel Grid.Row="1">
            <!-- SETUP: Filter form -->
            <ScrollViewer IsVisible="False" x:Name="SetupPanel" Padding="20,16">
                <StackPanel MaxWidth="500" Spacing="12">
                    <TextBlock Text="Capture Filters" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBright}" Margin="0,0,0,4"/>
                    <TextBlock Text="All filters are optional. Leave empty to capture everything."
                               FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

                    <TextBlock Text="Database" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding FilterDatabase}" Watermark="e.g., GratisWMS"
                             Padding="6,4" FontSize="12"/>

                    <TextBlock Text="Login" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding FilterLogin}" Watermark="e.g., wms_app"
                             Padding="6,4" FontSize="12"/>

                    <TextBlock Text="Application Name" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding FilterAppName}" Watermark="e.g., KorberWMS"
                             Padding="6,4" FontSize="12"/>

                    <TextBlock Text="Min Duration (ms)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <NumericUpDown Value="{Binding FilterMinDurationMs}" Minimum="0" Maximum="60000"
                                   Increment="100" FormatString="N0" Width="150"
                                   HorizontalAlignment="Left" FontSize="12"/>

                    <TextBlock Text="SQL Text Contains" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBox Text="{Binding FilterTextContains}" Watermark="e.g., inventory"
                             Padding="6,4" FontSize="12"/>

                    <Button Content="Start Capture" Command="{Binding StartCaptureCommand}"
                            Classes="btn-primary" Padding="16,8" Margin="0,12,0,0"
                            HorizontalAlignment="Left" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>

            <!-- RECORDING: Big indicator -->
            <StackPanel x:Name="RecordingPanel" IsVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="#e74c3c"/>
                    <TextBlock Text="Recording" FontSize="20" FontWeight="SemiBold"
                               Foreground="#e74c3c"/>
                </StackPanel>
                <TextBlock Text="{Binding ElapsedText}" FontSize="32"
                           FontFamily="Consolas, Menlo, Monaco, monospace"
                           Foreground="{DynamicResource TextBright}"
                           HorizontalAlignment="Center"/>
                <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} events captured">
                            <Binding Path="CapturedCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <Button Content="Stop Capture" Command="{Binding StopCaptureCommand}"
                        Classes="btn-danger" Padding="20,10" FontSize="13"
                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- RESULTS: Searchable grid + detail -->
            <Grid x:Name="ResultsPanel" IsVisible="False" RowDefinitions="Auto,*,Auto">
                <!-- Search bar -->
                <Border Grid.Row="0" Padding="8,6"
                        Background="{DynamicResource ToolbarBackground}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="Search:" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                 Watermark="Filter results..." Padding="6,3" FontSize="11"/>
                        <Button Grid.Column="2" Content="New Capture"
                                Command="{Binding ResetToSetupCommand}"
                                Classes="btn-secondary" Padding="10,4" FontSize="11" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Events grid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredEvents}"
                          SelectedItem="{Binding SelectedEvent}"
                          IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Width="110"
                            Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"/>
                        <DataGridTextColumn Header="Database" Width="100"
                            Binding="{Binding Database}"/>
                        <DataGridTextColumn Header="Login" Width="90"
                            Binding="{Binding Login}"/>
                        <DataGridTextColumn Header="Host" Width="80"
                            Binding="{Binding Host}"/>
                        <DataGridTextColumn Header="App" Width="90"
                            Binding="{Binding Application}"/>
                        <DataGridTextColumn Header="Duration" Width="80"
                            Binding="{Binding DurationDisplay}"/>
                        <DataGridTextColumn Header="CPU (ms)" Width="70"
                            Binding="{Binding CpuMs}"/>
                        <DataGridTextColumn Header="Reads" Width="70"
                            Binding="{Binding LogicalReads}"/>
                        <DataGridTextColumn Header="SQL Text" Width="*"
                            Binding="{Binding SqlTextPreview}"/>
                    </DataGrid.Columns>
                    <DataGrid.Styles>
                        <Style Selector="DataGridCell TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontFamily" Value="Consolas, Menlo, Monaco, monospace"/>
                        </Style>
                        <Style Selector="DataGridRow">
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </DataGrid.Styles>
                </DataGrid>

                <!-- Detail panel -->
                <Border Grid.Row="2" Height="120"
                        Background="{DynamicResource PanelHeaderBackground}"
                        BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                        IsVisible="{Binding SelectedEvent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer Padding="10,8">
                        <TextBlock Text="{Binding SelectedEvent.SqlText}"
                                   FontFamily="Consolas, Menlo, Monaco, monospace"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarConnected}"
                Padding="8,3" Height="22">
            <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                       Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
