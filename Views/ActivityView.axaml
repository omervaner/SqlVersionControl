<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             xmlns:views="using:SqlVersionControl.Views"
             x:Class="SqlVersionControl.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: Top Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="15,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <!-- Connection selector -->
                <views:ConnectionIndicator Grid.Column="0" x:Name="ActivityConnectionIndicator"/>

                <!-- Sub-tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="20,0,0,0">
                    <RadioButton x:Name="SessionsSubTab" GroupName="ActivitySubTabs"
                                 IsChecked="{Binding IsSessionsTabActive}"
                                 Classes="TabButton" Content="Sessions" FontSize="12"/>
                    <RadioButton x:Name="JobsSubTab" GroupName="ActivitySubTabs"
                                 IsChecked="{Binding IsJobsTabActive}"
                                 Classes="TabButton" Content="Jobs" FontSize="12"/>
                </StackPanel>

                <!-- Auto-refresh -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <CheckBox Content="Auto-refresh" IsChecked="{Binding AutoRefreshEnabled}" FontSize="11"/>
                    <ComboBox x:Name="RefreshIntervalCombo" MinWidth="65" FontSize="11"
                              IsEnabled="{Binding AutoRefreshEnabled}" SelectedIndex="2">
                        <ComboBoxItem Content="1s" Tag="1"/>
                        <ComboBoxItem Content="2s" Tag="2"/>
                        <ComboBoxItem Content="5s" Tag="5"/>
                        <ComboBoxItem Content="10s" Tag="10"/>
                        <ComboBoxItem Content="30s" Tag="30"/>
                    </ComboBox>
                </StackPanel>

                <!-- Refresh button -->
                <Button Grid.Column="4" Content="Refresh" Classes="btn-secondary"
                        Command="{Binding RefreshCommand}" Padding="10,4" Margin="10,0,0,0"
                        FontSize="11"/>

                <!-- Loading indicator -->
                <ProgressBar Grid.Column="5" IsIndeterminate="True" Width="60" Height="4"
                             IsVisible="{Binding IsLoading}" Margin="10,0,0,0"
                             Foreground="{DynamicResource AccentBlue}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SESSIONS TAB -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsSessionsTabActive}"
              RowDefinitions="Auto,Auto,Auto,*">

            <!-- Session Filters -->
            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBackground}" Padding="15,6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Hide sleeping" IsChecked="{Binding HideSleeping}" FontSize="11"/>
                    <TextBox Text="{Binding SessionSearchText}" Watermark="Search login, host, query..."
                             Width="200" FontSize="11"/>
                    <ComboBox ItemsSource="{Binding SessionDatabases}"
                              SelectedItem="{Binding SessionDatabaseFilter}"
                              MinWidth="120" FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- ── Dashboard Stat Cards (2x2) ── -->
            <Grid Grid.Row="1" Margin="10,8,10,0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">

                <!-- Card 1: CPU % -->
                <Border Grid.Column="0" CornerRadius="6" Padding="14,10"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="SQL CPU" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CpuValueText" Text="{Binding StatCpu}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource ScoreHealthy}"/>
                        <TextBlock Text="{Binding StatCpuDetail}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Memory -->
                <Border Grid.Column="1" CornerRadius="6" Padding="14,10"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Memory" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatMemory}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlue}"/>
                        <TextBlock Text="{Binding StatMemoryDetail}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Buffer Cache -->
                <Border Grid.Column="2" CornerRadius="6" Padding="14,10"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Buffer Cache" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BufferCacheValueText" Text="{Binding StatBufferCache}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource ScoreHealthy}"/>
                        <TextBlock Text="{Binding StatBufferCacheDetail}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: TempDB -->
                <Border Grid.Column="3" CornerRadius="6" Padding="14,10"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TempDB" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatTempDb}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningSeverityWarning}"/>
                        <TextBlock Text="{Binding StatTempDbDetail}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Blocking chain warning -->
            <Border Grid.Row="2" Background="{DynamicResource BlockingHighlight}"
                    BorderBrush="{DynamicResource ButtonDanger}" BorderThickness="0,0,0,2"
                    Padding="12,6" Margin="10,8,10,0"
                    CornerRadius="6"
                    IsVisible="{Binding HasBlockingChains}">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="13" Margin="0,0,8,0"
                               Foreground="{DynamicResource ButtonDanger}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding BlockingChainText}" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Sessions Grid — Dashboard Style -->
            <Border Grid.Row="3" Margin="10,8,10,4"
                    BorderBrush="{DynamicResource ActivityPanelBorder}"
                    BorderThickness="1" CornerRadius="6"
                    Background="{DynamicResource EditorBackground}"
                    ClipToBounds="True">
                <DataGrid x:Name="SessionsGrid"
                          ItemsSource="{Binding Sessions}"
                          SelectedItem="{Binding SelectedSession}"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Styles>
                        <Style Selector="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="DataGridRow:nth-child(2n)">
                            <Setter Property="Background" Value="{DynamicResource ActivityAlternateRow}"/>
                        </Style>
                    </DataGrid.Styles>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SPID" Binding="{Binding SessionId}" MinWidth="55" Width="Auto"/>
                        <DataGridTextColumn Header="Login" Binding="{Binding Login}" MinWidth="80" Width="Auto"/>
                        <DataGridTextColumn Header="Database" Binding="{Binding Database}" MinWidth="80" Width="Auto"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding RequestStatus}" MinWidth="80" Width="Auto"/>
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" MinWidth="80" Width="Auto"/>
                        <DataGridTextColumn Header="Wait Type" Binding="{Binding WaitType}" MinWidth="80" Width="Auto"/>
                        <DataGridTextColumn Header="Blocked By" Binding="{Binding BlockingDisplay}" MinWidth="75" Width="Auto"/>
                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuMs}" MinWidth="55" Width="Auto"/>
                        <DataGridTextColumn Header="Elapsed" Binding="{Binding ElapsedDisplay}" MinWidth="60" Width="Auto"/>
                        <DataGridTextColumn Header="Current Statement" Binding="{Binding CurrentStatementPreview}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- JOBS TAB -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsJobsTabActive}"
              RowDefinitions="Auto,Auto,Auto,*">

            <!-- Row 0: Filters + Action Buttons (merged into one bar) -->
            <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBackground}" Padding="15,6">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBox Text="{Binding JobSearchText}" Watermark="Search job name..."
                                 Width="180" FontSize="11"/>
                        <ComboBox x:Name="EnabledFilterCombo" MinWidth="110" FontSize="11"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Enabled only"/>
                            <ComboBoxItem Content="Disabled only"/>
                        </ComboBox>
                        <ComboBox x:Name="OutcomeFilterCombo" MinWidth="120" FontSize="11"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All outcomes"/>
                            <ComboBoxItem Content="Failed only"/>
                            <ComboBoxItem Content="Succeeded only"/>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding JobCategories}"
                                  SelectedItem="{Binding JobCategoryFilter}"
                                  MinWidth="120" FontSize="11"/>
                        <CheckBox Content="Running only" IsChecked="{Binding ShowOnlyRunning}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartJobButton" Content="Start" Classes="btn-secondary"
                                Padding="10,3" FontSize="11" Cursor="Hand"/>
                        <Button x:Name="StopJobButton" Content="Stop" Classes="btn-secondary"
                                Padding="10,3" FontSize="11" Cursor="Hand"/>
                        <Button x:Name="ToggleEnabledButton" Content="Enable/Disable" Classes="btn-secondary"
                                Padding="10,3" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Dashboard Stat Cards -->
            <Grid Grid.Row="1" Margin="10,8,10,0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" CornerRadius="6" Padding="14,10" Cursor="Hand"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}"
                        x:Name="CardTotalJobs">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Total Jobs" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatTotalJobs}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="6" Padding="14,10" Cursor="Hand"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}"
                        x:Name="CardFailedJobs">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Failed (24h)" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatFailedJobs}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource ButtonDanger}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="6" Padding="14,10" Cursor="Hand"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}"
                        x:Name="CardRunningJobs">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Running Now" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatRunningJobs}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBlue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" CornerRadius="6" Padding="14,10" Cursor="Hand"
                        BorderBrush="{DynamicResource ActivityPanelBorder}" BorderThickness="1"
                        Background="{DynamicResource EditorBackground}"
                        x:Name="CardDisabledJobs">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Disabled" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatDisabledJobs}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Failed Jobs Banner (conditional) -->
            <Border Grid.Row="2" Background="{DynamicResource BlockingHighlight}"
                    BorderBrush="{DynamicResource ButtonDanger}" BorderThickness="0,0,0,2"
                    Padding="12,6" Margin="10,8,10,0"
                    CornerRadius="6"
                    IsVisible="{Binding HasFailedJobs}">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="13" Margin="0,0,8,0"
                               Foreground="{DynamicResource ButtonDanger}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="FailedJobsBanner" Grid.Column="1"
                               Text="{Binding FailedJobsBannerText}" FontSize="11"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Row 3: Grids + Detail overlay -->
            <Panel Grid.Row="3">
                <!-- Grids layer (fills entire space) -->
                <DockPanel>
                    <!-- Disabled jobs docked at bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,4,10,4">
                        <Border x:Name="DisabledJobsHeader" Background="{DynamicResource PanelHeaderBackground}"
                                CornerRadius="6,6,0,0" Padding="12,5" Cursor="Hand"
                                IsVisible="{Binding DisabledJobs.Count}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="DisabledJobsArrow" Text="▸" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisabledJobsHeaderText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource ActivityPanelBorder}"
                                BorderThickness="1,0,1,1" CornerRadius="0,0,6,6"
                                Background="{DynamicResource EditorBackground}"
                                ClipToBounds="True" MaxHeight="200"
                                IsVisible="{Binding IsDisabledJobsExpanded}">
                            <DataGrid x:Name="DisabledJobsGrid"
                                      ItemsSource="{Binding DisabledJobs}"
                                      SelectedItem="{Binding SelectedJob}"
                                      IsReadOnly="True" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" CanUserResizeColumns="True"
                                      CanUserSortColumns="True" HeadersVisibility="Column"
                                      FontSize="11" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Styles>
                                    <Style Selector="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Style>
                                    <Style Selector="DataGridRow:nth-child(2n)">
                                        <Setter Property="Background" Value="{DynamicResource ActivityAlternateRow}"/>
                                    </Style>
                                    <Style Selector="DataGridCell">
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </DataGrid.Styles>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding CurrentStatus}" Width="70"/>
                                    <DataGridTextColumn Header="Last Outcome" Binding="{Binding LastRunOutcome}" Width="100"/>
                                    <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="125"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding LastDurationDisplay}" Width="75"/>
                                    <DataGridTextColumn Header="Next Run" Binding="{Binding NextRunDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="125"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- Enabled jobs grid (fills remaining space) -->
                    <Border Margin="10,8,10,0"
                            BorderBrush="{DynamicResource ActivityPanelBorder}"
                            BorderThickness="1" CornerRadius="6"
                            Background="{DynamicResource EditorBackground}"
                            ClipToBounds="True">
                        <DataGrid x:Name="JobsGrid"
                                  ItemsSource="{Binding EnabledJobs}"
                                  SelectedItem="{Binding SelectedJob}"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" CanUserResizeColumns="True"
                                  CanUserSortColumns="True" HeadersVisibility="Column"
                                  FontSize="11" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Styles>
                                <Style Selector="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                                <Style Selector="DataGridRow:nth-child(2n)">
                                    <Setter Property="Background" Value="{DynamicResource ActivityAlternateRow}"/>
                                </Style>
                                <Style Selector="DataGridCell">
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Job Name" Binding="{Binding JobName}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding CurrentStatus}" Width="70"/>
                                <DataGridTextColumn Header="Last Outcome" Binding="{Binding LastRunOutcome}" Width="100"/>
                                <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="125"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding LastDurationDisplay}" Width="75"/>
                                <DataGridTextColumn Header="Next Run" Binding="{Binding NextRunDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="125"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                                <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <!-- Detail panel overlay (bottom-docked, resizable via drag handle) -->
                <Border x:Name="JobDetailPanel"
                        IsVisible="{Binding IsJobDetailVisible}"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource EditorBackground}"
                        BorderBrush="{DynamicResource ActivityPanelBorder}"
                        BorderThickness="0,1,0,0"
                        Height="180">
                    <Grid RowDefinitions="4,Auto,*">
                        <!-- Resize handle -->
                        <Border x:Name="JobDetailResizeHandle" Grid.Row="0"
                                Background="{DynamicResource BorderDefault}"
                                Cursor="SizeNorthSouth" Height="4"/>

                        <!-- Detail sub-tabs + unsaved indicator -->
                        <Border Grid.Row="1" Background="{DynamicResource PanelHeaderBackground}" Padding="10,4">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                                    <RadioButton GroupName="JobDetailTabs"
                                                 IsChecked="{Binding IsJobGeneralTabActive}"
                                                 Classes="TabButton" Content="General" FontSize="11"/>
                                    <RadioButton GroupName="JobDetailTabs"
                                                 IsChecked="{Binding IsJobStepsTabActive}"
                                                 Classes="TabButton" Content="Steps" FontSize="11"/>
                                    <RadioButton GroupName="JobDetailTabs"
                                                 IsChecked="{Binding IsJobScheduleTabActive}"
                                                 Classes="TabButton" Content="Schedule" FontSize="11"/>
                                    <RadioButton GroupName="JobDetailTabs"
                                                 IsChecked="{Binding IsJobHistoryTabActive}"
                                                 Classes="TabButton" Content="History" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="● unsaved" FontSize="10"
                                           Foreground="{DynamicResource ButtonDanger}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding HasUnsavedChanges}"/>
                            </Grid>
                        </Border>

                        <!-- Tab content -->
                        <Panel Grid.Row="2">
                            <!-- GENERAL TAB -->
                            <ScrollViewer IsVisible="{Binding IsJobGeneralTabActive}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6" Margin="15,8">
                                    <Grid ColumnDefinitions="40,*,12,60,Auto,12,55,Auto">
                                        <TextBlock Grid.Column="0" Text="Name" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox Grid.Column="1" Text="{Binding EditJobName}" FontSize="11"/>
                                        <TextBlock Grid.Column="3" Text="Category" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <ComboBox Grid.Column="4" ItemsSource="{Binding AllCategories}"
                                                  SelectedItem="{Binding EditJobCategory}" MinWidth="180" FontSize="11"/>
                                        <TextBlock Grid.Column="6" Text="Enabled" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <CheckBox Grid.Column="7" IsChecked="{Binding EditJobEnabled}" FontSize="11"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="40,*">
                                        <TextBlock Grid.Column="0" Text="Desc" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBox Grid.Column="1" Text="{Binding EditJobDescription}"
                                                 FontSize="11" Height="28"/>
                                    </Grid>
                                    <Button Content="Save" Classes="btn-primary" Padding="14,4" FontSize="11"
                                            Command="{Binding SaveJobGeneralCommand}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- STEPS TAB -->
                            <Grid IsVisible="{Binding IsJobStepsTabActive}"
                                  RowDefinitions="*,Auto,Auto">
                                <DataGrid Grid.Row="0" ItemsSource="{Binding JobSteps}"
                                          SelectedItem="{Binding SelectedStep}"
                                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                                          BorderThickness="0" CanUserResizeColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding StepId}" Width="35"/>
                                        <DataGridTextColumn Header="Step Name" Binding="{Binding StepName}" Width="*"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Subsystem}" Width="70"/>
                                        <DataGridTextColumn Header="On Success" Binding="{Binding OnSuccessAction}" Width="110"/>
                                        <DataGridTextColumn Header="On Failure" Binding="{Binding OnFailureAction}" Width="110"/>
                                        <DataGridTextColumn Header="Command" Binding="{Binding CommandPreview}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox Grid.Row="1" Text="{Binding EditStepCommand}"
                                         FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="80" Margin="0,2,0,0"
                                         Watermark="Select a step to edit its command..."/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4">
                                    <Button Content="Save Step" Classes="btn-primary" Padding="10,4" FontSize="11"
                                            Command="{Binding SaveStepCommand}"/>
                                    <Button Content="Add Step" Classes="btn-secondary" Padding="10,4" FontSize="11"
                                            Command="{Binding AddStepCommand}"/>
                                    <Button x:Name="DeleteStepButton" Content="Delete Step" Classes="btn-secondary"
                                            Padding="10,4" FontSize="11"/>
                                    <Button x:Name="OpenStepButton" Content="Open in Editor" Classes="btn-secondary"
                                            Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- SCHEDULE TAB -->
                            <ScrollViewer IsVisible="{Binding IsJobScheduleTabActive}"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10" Margin="15,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Preview:" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding SchedulePreview}" FontSize="11"
                                                   Foreground="{DynamicResource AccentBlue}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Frequency" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FreqTypeCombo"
                                                  MinWidth="200" FontSize="11" SelectedIndex="0">
                                            <ComboBoxItem Content="Daily" Tag="4"/>
                                            <ComboBoxItem Content="Weekly" Tag="8"/>
                                            <ComboBoxItem Content="Monthly" Tag="16"/>
                                            <ComboBoxItem Content="Once" Tag="1"/>
                                            <ComboBoxItem Content="When SQL Agent starts" Tag="64"/>
                                            <ComboBoxItem Content="When CPU is idle" Tag="128"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Interval" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Every" FontSize="11" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding EditFreqInterval}" Minimum="1" Maximum="365"
                                                           Width="80" FontSize="11" FormatString="0"/>
                                            <TextBlock Text="day(s)" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Days" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <CheckBox Content="Sun" IsChecked="{Binding SchedSun}" FontSize="10"/>
                                            <CheckBox Content="Mon" IsChecked="{Binding SchedMon}" FontSize="10"/>
                                            <CheckBox Content="Tue" IsChecked="{Binding SchedTue}" FontSize="10"/>
                                            <CheckBox Content="Wed" IsChecked="{Binding SchedWed}" FontSize="10"/>
                                            <CheckBox Content="Thu" IsChecked="{Binding SchedThu}" FontSize="10"/>
                                            <CheckBox Content="Fri" IsChecked="{Binding SchedFri}" FontSize="10"/>
                                            <CheckBox Content="Sat" IsChecked="{Binding SchedSat}" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Recurrence" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <ComboBox x:Name="SubdayTypeCombo" MinWidth="130" FontSize="11" SelectedIndex="0">
                                                <ComboBoxItem Content="Once at time" Tag="1"/>
                                                <ComboBoxItem Content="Every N minutes" Tag="4"/>
                                                <ComboBoxItem Content="Every N hours" Tag="8"/>
                                            </ComboBox>
                                            <NumericUpDown Value="{Binding EditFreqSubdayInterval}" Minimum="1" Maximum="60"
                                                           Width="70" FontSize="11" FormatString="0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Start time" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <NumericUpDown Value="{Binding EditActiveStartHour}" Minimum="0" Maximum="23"
                                                           Width="65" FontSize="11" FormatString="00"/>
                                            <TextBlock Text=":" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding EditActiveStartMinute}" Minimum="0" Maximum="59"
                                                           Width="65" FontSize="11" FormatString="00"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Content="Save Schedule" Classes="btn-primary" Padding="14,5" FontSize="11"
                                                Command="{Binding SaveScheduleCommand}"/>
                                        <Button x:Name="RemoveScheduleButton" Content="Remove Schedule" Classes="btn-secondary" Padding="10,5" FontSize="11"
                                                IsVisible="{Binding HasSchedule}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- HISTORY TAB -->
                            <DataGrid x:Name="JobHistoryGrid"
                                      ItemsSource="{Binding JobHistory}"
                                      IsReadOnly="True" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" CanUserResizeColumns="True"
                                      IsVisible="{Binding IsJobHistoryTabActive}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding RunDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="130"/>
                                    <DataGridTextColumn Header="Outcome" Binding="{Binding RunStatusDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="70"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Panel>
                    </Grid>
                </Border>
            </Panel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource PanelHeaderBackground}" Padding="10,3">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
        </Border>
    </Grid>
</UserControl>
