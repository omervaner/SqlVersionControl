<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             xmlns:views="using:SqlVersionControl.Views"
             x:Class="SqlVersionControl.Views.CompareView"
             x:DataType="vm:CompareViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Top Bar Row 1: Source, Search, Target1 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Source Connection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Source:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding SourceConnections}"
                              SelectedItem="{Binding SelectedSourceConnection}"
                              MinWidth="160"
                              PlaceholderText="Select source...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Name="AddSourceButton" Content="+" Classes="btn-secondary"
                            ToolTip.Tip="Add new connection" Padding="6,2" FontWeight="Bold"/>
                </StackPanel>

                <!-- Mode Toggle + Search (centered) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsTableCompareMode}"
                                  Padding="8,4" FontSize="11" FontWeight="SemiBold"
                                  ToolTip.Tip="Toggle between code objects and table structure comparison">
                        <Panel>
                            <TextBlock Text="Code" IsVisible="{Binding !IsTableCompareMode}"/>
                            <TextBlock Text="Tables" IsVisible="{Binding IsTableCompareMode}"/>
                        </Panel>
                    </ToggleButton>
                    <TextBox x:Name="CompareSearchBox" Text="{Binding SearchText}"
                             Watermark="Search objects..."
                             Width="200"/>
                </StackPanel>

                <!-- Target1 Connection + T2 Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Target 1:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding TargetConnections}"
                              SelectedItem="{Binding SelectedTargetConnection}"
                              MinWidth="160"
                              PlaceholderText="Select target...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Name="AddTargetButton" Content="+" Classes="btn-secondary"
                            ToolTip.Tip="Add new connection" Padding="6,2" FontWeight="Bold"/>
                    <Button Command="{Binding ToggleTarget2Command}"
                            Content="{Binding ToggleTarget2ButtonText}"
                            Classes="btn-toggle"
                            ToolTip.Tip="Add/remove third database for 3-way compare"
                            Padding="8,2" FontWeight="Bold" Margin="8,0,0,0"
                            IsVisible="{Binding !IsTableCompareMode}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Bar Row 2: Target2 (only visible when ShowTarget2 is true) -->
        <Border Grid.Row="1" Background="{DynamicResource PanelHeaderBackground}" Padding="10,6" IsVisible="{Binding ShowTarget2}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <TextBlock Text="Target 2:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Target2Connections}"
                          SelectedItem="{Binding SelectedTarget2Connection}"
                          MinWidth="160"
                          PlaceholderText="Select target 2...">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Name="AddTarget2Button" Content="+" Classes="btn-secondary"
                        ToolTip.Tip="Add new connection" Padding="6,2" FontWeight="Bold"/>
                <TextBlock Text="{Binding Target2Status}" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnDefinitions="200,Auto,*">
            <!-- Object List -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Objects" FontWeight="SemiBold" FontSize="12"/>
                            <CheckBox Content="Show only differences"
                                      IsChecked="{Binding ShowOnlyDifferences}"
                                      FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress Bar (when scanning) -->
                    <Border Grid.Row="1" Padding="10,5" Background="{DynamicResource ScanProgressBackground}"
                            IsVisible="{Binding IsScanning}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding ScanProgressText}" FontSize="10" Foreground="{DynamicResource WarningSeverityWarning}"/>
                            <ProgressBar Value="{Binding ScanProgress}" Minimum="0" Maximum="100" Height="8"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary Stats -->
                    <Border Grid.Row="2" Padding="10,8" Background="{DynamicResource SummaryStatsBackground}"
                            IsVisible="{Binding HasSummary}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}">Summary:</TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock FontSize="10">
                                    <Run Text="~" Foreground="{DynamicResource WarningSeverityWarning}" FontWeight="Bold"/>
                                    <Run Text="{Binding ModifiedCount}"/> Modified
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    <Run Text="+" Foreground="{DynamicResource ButtonPrimary}" FontWeight="Bold"/>
                                    <Run Text="{Binding SourceOnlyCount}"/> Source
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    <Run Text="-" Foreground="{DynamicResource ButtonDanger}" FontWeight="Bold"/>
                                    <Run Text="{Binding TargetOnlyCount}"/> Target
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Objects}"
                             SelectedItem="{Binding SelectedObject}"
                             Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              IsVisible="{Binding ExistsInSource}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusIcon}" FontWeight="Bold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                               VerticalAlignment="Center" Width="12"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ObjectName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SchemaName}" FontSize="10" Foreground="{DynamicResource TextDisabled}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Resizable Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Detail Panel Container -->
            <Grid Grid.Column="2">
                <!-- Table Structure Comparison Grid (table mode) -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsTableCompareMode}">
                    <Border Grid.Row="0" Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <TextBlock Text="Column Comparison" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid x:Name="TableCompareGrid" Grid.Row="1"
                              ItemsSource="{Binding TableCompareColumns}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" Width="*"/>
                            <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" Width="*"/>
                            <DataGridTextColumn Header="Target Type" Binding="{Binding TargetType}" Width="*"/>
                            <DataGridTextColumn Header="Source Null" Binding="{Binding SourceNullable}" Width="80"/>
                            <DataGridTextColumn Header="Target Null" Binding="{Binding TargetNullable}" Width="80"/>
                            <DataGridTextColumn Header="Source Default" Binding="{Binding SourceDefault}" Width="*"/>
                            <DataGridTextColumn Header="Target Default" Binding="{Binding TargetDefault}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusText, Converter={StaticResource ColumnStatusToColorConverter}}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="→" FontWeight="Bold" FontSize="12"
                                                Padding="6,2" HorizontalAlignment="Center"
                                                IsVisible="{Binding IsDeployable}"
                                                Command="{Binding #TableCompareGrid.((vm:CompareViewModel)DataContext).DeployColumnCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Deploy this column to target"
                                                Classes="btn-primary"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Code Diff Views (code mode) — single diff -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsTableCompareMode}">
                    <!-- Headers (single diff) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                          IsVisible="{Binding !ShowTarget2}">
                        <Border Grid.Column="0" Padding="10" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Source Definition" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Copy" Command="{Binding CopySourceCommand}"
                                        FontSize="10" Padding="8,2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Target Definition" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Copy" Command="{Binding CopyTargetCommand}"
                                        FontSize="10" Padding="8,2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Side by Side Diff (single) -->
                    <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel}" x:Name="CompareDiffView"
                                    IsVisible="{Binding !ShowTarget2}"/>

                    <!-- Three-way diff view (when Target2 shown) -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="*,Auto,*" IsVisible="{Binding ShowTarget2}">
                        <!-- First Diff: Source ↔ Target1 -->
                        <Grid Grid.Row="0" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <Border Grid.Column="0" Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Source" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopySourceCommand}"
                                                FontSize="10" Padding="6,2" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Padding="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Target 1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyTargetCommand}"
                                                FontSize="10" Padding="6,2" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel}" x:Name="CompareDiffView1"/>
                        </Grid>

                        <!-- Splitter between diff views -->
                        <GridSplitter Grid.Row="1" Height="5" Background="{DynamicResource ButtonSecondary}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                        <!-- Second Diff: Target1 ↔ Target2 -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <Border Grid.Column="0" Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Target 1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" Padding="8">
                                    <TextBlock Text="Target 2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel2}" x:Name="CompareDiffView2"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Bar: Deploy Button and Status -->
        <Border Grid.Row="3" Background="{DynamicResource ToolbarBackground}" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                <!-- Refresh Button -->
                <Button Grid.Column="0" Content="⟳ Refresh" Classes="btn-secondary"
                        Command="{Binding RefreshCommand}" Margin="0,0,15,0"
                        FontWeight="SemiBold"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>

                <!-- Selection controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="0,0,15,0">
                    <Button Content="All" Classes="btn-secondary"
                            Command="{Binding SelectAllCommand}" FontSize="10" Padding="8,4"/>
                    <Button Content="None" Classes="btn-secondary"
                            Command="{Binding DeselectAllCommand}" FontSize="10" Padding="8,4"/>
                </StackPanel>

                <!-- Deploy Selected -->
                <Button Grid.Column="3" Command="{Binding DeploySelectedCommand}"
                        IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource PlanScanOrange}" Foreground="{DynamicResource ButtonForeground}"
                        Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Deploy"/>
                        <TextBlock Text="{Binding SelectedCount}"/>
                        <TextBlock Text="Selected"/>
                    </StackPanel>
                </Button>

                <!-- Deploy Source → Target1 -->
                <Button Grid.Column="4" Content="Deploy to Target 1"
                        Classes="btn-primary"
                        Command="{Binding DeployCommand}"
                        IsEnabled="{Binding CanDeploy}"
                        Margin="0,0,10,0"/>

                <!-- Deploy Target1 → Target2 (only visible in three-way mode) -->
                <Button Grid.Column="5" Content="Deploy to Target 2"
                        Classes="btn-toggle"
                        Command="{Binding Deploy2Command}"
                        IsEnabled="{Binding CanDeploy2}"
                        IsVisible="{Binding ShowTarget2}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
