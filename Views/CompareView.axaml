<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlVersionControl.ViewModels"
             xmlns:views="using:SqlVersionControl.Views"
             x:Class="SqlVersionControl.Views.CompareView"
             x:DataType="vm:CompareViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Top Bar Row 1: Source, Search, Target1 -->
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Source Connection -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Source:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                    <views:ConnectionIndicator x:Name="SourceConnectionIndicator"/>
                </StackPanel>

                <!-- Mode Toggle + Search (centered) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource SidebarBackground}" CornerRadius="4" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <RadioButton x:Name="ModeCode" GroupName="CompareMode" IsChecked="True"
                                         Classes="ModeButton" Content="Code"/>
                            <RadioButton x:Name="ModeTables" GroupName="CompareMode"
                                         Classes="ModeButton" Content="Tables"/>
                            <RadioButton x:Name="ModeData" GroupName="CompareMode"
                                         Classes="ModeButton" Content="Data"/>
                        </StackPanel>
                    </Border>
                    <TextBox x:Name="CompareSearchBox" Text="{Binding SearchText}"
                             Watermark="Search objects..."
                             Width="200"/>
                </StackPanel>

                <!-- Target1 Connection + T2 Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Target 1:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                    <views:ConnectionIndicator x:Name="TargetConnectionIndicator"/>
                    <Button Command="{Binding ToggleTarget2Command}"
                            Content="{Binding ToggleTarget2ButtonText}"
                            Classes="btn-toggle"
                            ToolTip.Tip="Add/remove third database for 3-way compare"
                            Padding="8,2" FontWeight="Bold" Margin="8,0,0,0"
                            IsVisible="{Binding !IsTableCompareMode}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top Bar Row 2: Target2 (only visible when ShowTarget2 is true) -->
        <Border Grid.Row="1" Background="{DynamicResource PanelHeaderBackground}" Padding="10,6" IsVisible="{Binding ShowTarget2}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <TextBlock Text="Target 2:" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" FontSize="12"/>
                <views:ConnectionIndicator x:Name="Target2ConnectionIndicator"/>
                <TextBlock Text="{Binding Target2Status}" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnDefinitions="200,Auto,*">
            <!-- Object List -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Objects" FontWeight="SemiBold" FontSize="12"/>
                            <CheckBox Content="Show only differences"
                                      IsChecked="{Binding ShowOnlyDifferences}"
                                      FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Progress Bar (when scanning) -->
                    <Border Grid.Row="1" Padding="10,5" Background="{DynamicResource ScanProgressBackground}"
                            IsVisible="{Binding IsScanning}">
                        <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding ScanProgressText}" FontSize="10" Foreground="{DynamicResource WarningSeverityWarning}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelScanCommand}"
                                        Classes="btn-secondary" Padding="8,2" FontSize="10" Cursor="Hand"/>
                            </Grid>
                            <ProgressBar Value="{Binding ScanProgress}" Minimum="0" Maximum="100" Height="8"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary Stats -->
                    <Border Grid.Row="2" Padding="10,8" Background="{DynamicResource SummaryStatsBackground}"
                            IsVisible="{Binding HasSummary}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}">Summary:</TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock FontSize="10">
                                    <Run Text="~" Foreground="{DynamicResource WarningSeverityWarning}" FontWeight="Bold"/>
                                    <Run Text="{Binding ModifiedCount}"/> Modified
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    <Run Text="+" Foreground="{DynamicResource ButtonPrimary}" FontWeight="Bold"/>
                                    <Run Text="{Binding SourceOnlyCount}"/> Source
                                </TextBlock>
                                <TextBlock FontSize="10">
                                    <Run Text="-" Foreground="{DynamicResource ButtonDanger}" FontWeight="Bold"/>
                                    <Run Text="{Binding TargetOnlyCount}"/> Target
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Empty state hint -->
                    <TextBlock Grid.Row="3"
                               Text="Select a source and target connection above, then click Compare to see differences."
                               FontSize="12" Foreground="{DynamicResource TextDisabled}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxWidth="220" Margin="20"
                               IsVisible="{Binding !HasObjects}"/>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding Objects}"
                             SelectedItem="{Binding SelectedObject}"
                             Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              IsVisible="{Binding ExistsInSource}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusIcon}" FontWeight="Bold"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                               VerticalAlignment="Center" Width="12"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ObjectName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SchemaName}" FontSize="10" Foreground="{DynamicResource TextDisabled}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Resizable Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Detail Panel Container -->
            <Grid Grid.Column="2">
                <!-- Overlay when connections are incomplete (tables/data modes) -->
                <Border IsVisible="{Binding ShowCompareOverlay}" ZIndex="1"
                        Background="#80000000" IsHitTestVisible="False">
                    <TextBlock Text="{Binding CompareOverlayMessage}"
                               Foreground="#cccccc"
                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxWidth="300"/>
                </Border>

                <!-- Table Structure Comparison Grid (table mode, not data mode) -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsTableCompareMode}">
                    <Border Grid.Row="0" Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            IsVisible="{Binding !IsDataCompareMode}">
                        <TextBlock Text="Column Comparison" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Structure comparison grid -->
                    <DataGrid x:Name="TableCompareGrid" Grid.Row="1"
                              ItemsSource="{Binding TableCompareColumns}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              IsVisible="{Binding !IsDataCompareMode}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" Width="*"/>
                            <DataGridTextColumn Header="Source Type" Binding="{Binding SourceType}" Width="*"/>
                            <DataGridTextColumn Header="Target Type" Binding="{Binding TargetType}" Width="*"/>
                            <DataGridTextColumn Header="Source Null" Binding="{Binding SourceNullable}" Width="80"/>
                            <DataGridTextColumn Header="Target Null" Binding="{Binding TargetNullable}" Width="80"/>
                            <DataGridTextColumn Header="Source Default" Binding="{Binding SourceDefault}" Width="*"/>
                            <DataGridTextColumn Header="Target Default" Binding="{Binding TargetDefault}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusText, Converter={StaticResource ColumnStatusToColorConverter}}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="→" FontWeight="Bold" FontSize="12"
                                                Padding="6,2" HorizontalAlignment="Center"
                                                IsVisible="{Binding IsDeployable}"
                                                Command="{Binding #TableCompareGrid.((vm:CompareViewModel)DataContext).DeployColumnCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Deploy this column to target"
                                                Classes="btn-primary"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Data Compare View (replaces structure grid when active) -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*,Auto,Auto"
                          IsVisible="{Binding IsDataCompareMode}">

                        <!-- Row 0: Toolbar — Back, Table name, Filter, Summary -->
                        <Border Grid.Row="0" Padding="10,8" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SelectedObject.FullName}"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                <!-- Column filter -->
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataFilterColumns}"
                                          SelectedItem="{Binding DataFilterColumn}"
                                          MinWidth="120" Margin="15,0,0,0"
                                          PlaceholderText="All columns"/>
                                <TextBox Grid.Column="2" Text="{Binding DataFilterText}"
                                         Watermark="Filter..." Width="150" Margin="6,0,0,0"/>

                                <!-- Loading indicator -->
                                <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="100"
                                             IsVisible="{Binding IsDataLoading}" Foreground="{DynamicResource AccentBlue}"
                                             VerticalAlignment="Center" Margin="15,0"/>

                                <Button Grid.Column="4" Content="⟳ Refresh" Classes="btn-secondary"
                                        Command="{Binding CompareDataCommand}" Padding="8,4" FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Row 1: Summary bar -->
                        <Border Grid.Row="1" Padding="10,5" Background="{DynamicResource SummaryStatsBackground}"
                                IsVisible="{Binding DataCompareSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding DataCompareSummary}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Border>

                        <!-- Row 2: Master grid (all rows) -->
                        <DataGrid x:Name="DataCompareGrid" Grid.Row="2"
                                  ItemsSource="{Binding FilteredDataRows}"
                                  SelectedItem="{Binding SelectedDataRow}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"/>

                        <!-- Row 3: Splitter -->
                        <GridSplitter Grid.Row="3" Height="5"
                                      Background="{DynamicResource BorderDefault}"
                                      HorizontalAlignment="Stretch"/>

                        <!-- Row 4: Detail panel (field-by-field for selected row) -->
                        <Grid Grid.Row="4" RowDefinitions="Auto,*" MinHeight="150">
                            <Border Grid.Row="0" Padding="10,6" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Text="Row Detail" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Show SQL" Classes="btn-secondary"
                                            Command="{Binding ShowDataDeploySqlCommand}"
                                            Padding="8,4" FontSize="11" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="Deploy Selected" Classes="btn-primary"
                                            Command="{Binding DeployDataRowsCommand}"
                                            Padding="8,4" FontSize="11" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                        <Button Content="All" Classes="btn-secondary"
                                                Command="{Binding SelectAllDataRowsCommand}" FontSize="10" Padding="6,3"/>
                                        <Button Content="None" Classes="btn-secondary"
                                                Command="{Binding DeselectAllDataRowsCommand}" FontSize="10" Padding="6,3"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="DetailFieldGrid" Grid.Row="1"
                                      ItemsSource="{Binding SelectedRowFields}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      CanUserReorderColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Column" Binding="{Binding ColumnName}" Width="150"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="Target" Binding="{Binding TargetDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                                    <DataGridTemplateColumn Header="" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="→" FontWeight="Bold" FontSize="12"
                                                        Padding="6,2" HorizontalAlignment="Center"
                                                        IsVisible="{Binding IsDifferent}"
                                                        Command="{Binding #DetailFieldGrid.((vm:CompareViewModel)DataContext).DeployFieldCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Deploy this field to target"
                                                        Classes="btn-primary"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Code Diff Views (code mode — hidden in table and data modes) -->
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsTableCompareMode}">
                    <!-- Headers (single diff) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                          IsVisible="{Binding !ShowTarget2}">
                        <Border Grid.Column="0" Padding="10" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Source Definition" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Copy" Command="{Binding CopySourceCommand}"
                                        FontSize="10" Padding="8,2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Padding="10" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Target Definition" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Copy" Command="{Binding CopyTargetCommand}"
                                        FontSize="10" Padding="8,2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Side by Side Diff (single) -->
                    <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel}" x:Name="CompareDiffView"
                                    IsVisible="{Binding !ShowTarget2}"/>

                    <!-- Target-side overlay in code mode when target not connected -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" ColumnDefinitions="*,*"
                          IsVisible="{Binding !IsTargetConnected}" IsHitTestVisible="False"
                          ZIndex="1">
                        <Border Grid.Column="1" Background="#80000000">
                            <TextBlock Text="Select a target database to compare against"
                                       Foreground="#cccccc"
                                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       MaxWidth="200"/>
                        </Border>
                    </Grid>

                    <!-- Three-way diff view (when Target2 shown) -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" RowDefinitions="*,Auto,*" IsVisible="{Binding ShowTarget2}">
                        <!-- First Diff: Source ↔ Target1 -->
                        <Grid Grid.Row="0" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <Border Grid.Column="0" Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Source" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopySourceCommand}"
                                                FontSize="10" Padding="6,2" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Padding="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Target 1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Copy" Command="{Binding CopyTargetCommand}"
                                                FontSize="10" Padding="6,2" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel}" x:Name="CompareDiffView1"/>
                        </Grid>

                        <!-- Splitter between diff views -->
                        <GridSplitter Grid.Row="1" Height="5" Background="{DynamicResource ButtonSecondary}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                        <!-- Second Diff: Target1 ↔ Target2 -->
                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                                <Border Grid.Column="0" Padding="8" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="0,0,1,0">
                                    <TextBlock Text="Target 1" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" Padding="8">
                                    <TextBlock Text="Target 2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <views:DiffView Grid.Row="1" DiffModel="{Binding DiffModel2}" x:Name="CompareDiffView2"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Bar: Deploy Button and Status -->
        <Border Grid.Row="3" Background="{DynamicResource ToolbarBackground}" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                <!-- Refresh Button -->
                <Button Grid.Column="0" Content="⟳ Refresh" Classes="btn-secondary"
                        Command="{Binding RefreshCommand}" Margin="0,0,15,0"
                        FontWeight="SemiBold"
                        IsVisible="{Binding !IsDataCompareMode}"/>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>

                <!-- Structure/Code mode controls (hidden in data mode) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="0,0,15,0"
                            IsVisible="{Binding !IsDataCompareMode}">
                    <Button Content="All" Classes="btn-secondary"
                            Command="{Binding SelectAllCommand}" FontSize="10" Padding="8,4"/>
                    <Button Content="None" Classes="btn-secondary"
                            Command="{Binding DeselectAllCommand}" FontSize="10" Padding="8,4"/>
                </StackPanel>

                <Panel Grid.Column="3" IsVisible="{Binding !IsDataCompareMode}">
                    <Button Command="{Binding DeploySelectedCommand}"
                            IsVisible="{Binding HasSelection}"
                            Background="{DynamicResource PlanScanOrange}" Foreground="{DynamicResource ButtonForeground}"
                            Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="Deploy"/>
                            <TextBlock Text="{Binding SelectedCount}"/>
                            <TextBlock Text="Selected"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelDeployCommand}"
                            IsVisible="{Binding IsDeploying}"
                            Classes="btn-secondary" Padding="12,6" Margin="0,0,10,0"
                            Content="Cancel Deploy" Cursor="Hand"/>
                </Panel>

                <Button Grid.Column="4" Content="Deploy to Target 1"
                        Classes="btn-primary"
                        Command="{Binding DeployCommand}"
                        IsEnabled="{Binding CanDeploy}"
                        Margin="0,0,10,0"
                        IsVisible="{Binding !IsDataCompareMode}"/>

                <Button Grid.Column="5" Content="Deploy to Target 2"
                        Classes="btn-toggle"
                        Command="{Binding Deploy2Command}"
                        IsEnabled="{Binding CanDeploy2}"
                        IsVisible="{Binding ShowTarget2}"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="RadioButton.ModeButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.ModeButton:checked">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="RadioButton.ModeButton:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="RadioButton.ModeButton:checked:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
</UserControl>
